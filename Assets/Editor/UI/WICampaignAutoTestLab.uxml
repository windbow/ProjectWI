<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement class="auto-test-root">
        <ui:Label text="CAMPAIGN AUTO TEST LAB" class="title" />
        <ui:Label text="컴퓨터가 캠페인을 결말 또는 최대 개월까지 진행하고 정책별 결과를 비교합니다." class="subtitle" />
        <ui:VisualElement class="settings-panel">
            <uie:ObjectField name="database-field" label="내정 데이터베이스" />
            <ui:VisualElement class="settings-row">
                <ui:DropdownField name="difficulty-field" label="난이도" class="setting-field" />
                <ui:DropdownField name="policy-field" label="정책" class="setting-field" />
                <ui:IntegerField name="maximum-months-field" label="최대 개월" class="setting-field" />
            </ui:VisualElement>
            <ui:Toggle name="run-matrix-toggle" label="정책 3종 × 난이도 3종 전체 비교" />
            <ui:VisualElement class="button-row">
                <ui:Button name="run-button" text="자동 캠페인 실행" class="primary-button" />
                <ui:Button name="export-csv-button" text="CSV 내보내기" />
                <ui:Button name="export-markdown-button" text="Markdown 내보내기" />
            </ui:VisualElement>
            <ui:Label name="status-label" text="실행 대기" class="status-label" />
        </ui:VisualElement>
        <ui:VisualElement class="result-header result-row">
            <ui:Label text="난이도" class="col-difficulty" /><ui:Label text="정책" class="col-policy" />
            <ui:Label text="개월" class="col-number" /><ui:Label text="결과" class="col-result" />
            <ui:Label text="성" class="col-number" /><ui:Label text="전투(승/패)" class="col-battles" />
            <ui:Label text="출정" class="col-number" /><ui:Label text="소유권" class="col-number" />
            <ui:Label text="선택" class="col-number" />
        </ui:VisualElement>
        <ui:ScrollView class="result-scroll">
            <ui:VisualElement name="result-row-0" class="result-row"><ui:Label name="result-0-difficulty" class="col-difficulty"/><ui:Label name="result-0-policy" class="col-policy"/><ui:Label name="result-0-months" class="col-number"/><ui:Label name="result-0-result" class="col-result"/><ui:Label name="result-0-castles" class="col-number"/><ui:Label name="result-0-battles" class="col-battles"/><ui:Label name="result-0-marches" class="col-number"/><ui:Label name="result-0-changes" class="col-number"/><ui:Label name="result-0-decisions" class="col-number"/></ui:VisualElement>
            <ui:VisualElement name="result-row-1" class="result-row"><ui:Label name="result-1-difficulty" class="col-difficulty"/><ui:Label name="result-1-policy" class="col-policy"/><ui:Label name="result-1-months" class="col-number"/><ui:Label name="result-1-result" class="col-result"/><ui:Label name="result-1-castles" class="col-number"/><ui:Label name="result-1-battles" class="col-battles"/><ui:Label name="result-1-marches" class="col-number"/><ui:Label name="result-1-changes" class="col-number"/><ui:Label name="result-1-decisions" class="col-number"/></ui:VisualElement>
            <ui:VisualElement name="result-row-2" class="result-row"><ui:Label name="result-2-difficulty" class="col-difficulty"/><ui:Label name="result-2-policy" class="col-policy"/><ui:Label name="result-2-months" class="col-number"/><ui:Label name="result-2-result" class="col-result"/><ui:Label name="result-2-castles" class="col-number"/><ui:Label name="result-2-battles" class="col-battles"/><ui:Label name="result-2-marches" class="col-number"/><ui:Label name="result-2-changes" class="col-number"/><ui:Label name="result-2-decisions" class="col-number"/></ui:VisualElement>
            <ui:VisualElement name="result-row-3" class="result-row"><ui:Label name="result-3-difficulty" class="col-difficulty"/><ui:Label name="result-3-policy" class="col-policy"/><ui:Label name="result-3-months" class="col-number"/><ui:Label name="result-3-result" class="col-result"/><ui:Label name="result-3-castles" class="col-number"/><ui:Label name="result-3-battles" class="col-battles"/><ui:Label name="result-3-marches" class="col-number"/><ui:Label name="result-3-changes" class="col-number"/><ui:Label name="result-3-decisions" class="col-number"/></ui:VisualElement>
            <ui:VisualElement name="result-row-4" class="result-row"><ui:Label name="result-4-difficulty" class="col-difficulty"/><ui:Label name="result-4-policy" class="col-policy"/><ui:Label name="result-4-months" class="col-number"/><ui:Label name="result-4-result" class="col-result"/><ui:Label name="result-4-castles" class="col-number"/><ui:Label name="result-4-battles" class="col-battles"/><ui:Label name="result-4-marches" class="col-number"/><ui:Label name="result-4-changes" class="col-number"/><ui:Label name="result-4-decisions" class="col-number"/></ui:VisualElement>
            <ui:VisualElement name="result-row-5" class="result-row"><ui:Label name="result-5-difficulty" class="col-difficulty"/><ui:Label name="result-5-policy" class="col-policy"/><ui:Label name="result-5-months" class="col-number"/><ui:Label name="result-5-result" class="col-result"/><ui:Label name="result-5-castles" class="col-number"/><ui:Label name="result-5-battles" class="col-battles"/><ui:Label name="result-5-marches" class="col-number"/><ui:Label name="result-5-changes" class="col-number"/><ui:Label name="result-5-decisions" class="col-number"/></ui:VisualElement>
            <ui:VisualElement name="result-row-6" class="result-row"><ui:Label name="result-6-difficulty" class="col-difficulty"/><ui:Label name="result-6-policy" class="col-policy"/><ui:Label name="result-6-months" class="col-number"/><ui:Label name="result-6-result" class="col-result"/><ui:Label name="result-6-castles" class="col-number"/><ui:Label name="result-6-battles" class="col-battles"/><ui:Label name="result-6-marches" class="col-number"/><ui:Label name="result-6-changes" class="col-number"/><ui:Label name="result-6-decisions" class="col-number"/></ui:VisualElement>
            <ui:VisualElement name="result-row-7" class="result-row"><ui:Label name="result-7-difficulty" class="col-difficulty"/><ui:Label name="result-7-policy" class="col-policy"/><ui:Label name="result-7-months" class="col-number"/><ui:Label name="result-7-result" class="col-result"/><ui:Label name="result-7-castles" class="col-number"/><ui:Label name="result-7-battles" class="col-battles"/><ui:Label name="result-7-marches" class="col-number"/><ui:Label name="result-7-changes" class="col-number"/><ui:Label name="result-7-decisions" class="col-number"/></ui:VisualElement>
            <ui:VisualElement name="result-row-8" class="result-row"><ui:Label name="result-8-difficulty" class="col-difficulty"/><ui:Label name="result-8-policy" class="col-policy"/><ui:Label name="result-8-months" class="col-number"/><ui:Label name="result-8-result" class="col-result"/><ui:Label name="result-8-castles" class="col-number"/><ui:Label name="result-8-battles" class="col-battles"/><ui:Label name="result-8-marches" class="col-number"/><ui:Label name="result-8-changes" class="col-number"/><ui:Label name="result-8-decisions" class="col-number"/></ui:VisualElement>
        </ui:ScrollView>
        <ui:Label text="※ 자동 테스트는 진행 가능성·정체·밸런스 이상을 찾으며 사람의 재미 체감을 대신하지 않습니다." class="footnote" />
    </ui:VisualElement>
</ui:UXML>
