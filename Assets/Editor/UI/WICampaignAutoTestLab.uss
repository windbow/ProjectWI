.auto-test-root { flex-grow: 1; padding: 18px; background-color: rgb(28, 32, 38); color: rgb(226, 230, 235); }
.title { font-size: 22px; -unity-font-style: bold; color: rgb(245, 247, 250); margin-bottom: 4px; }
.subtitle { color: rgb(166, 176, 188); margin-bottom: 14px; }
.settings-panel { padding: 12px; margin-bottom: 14px; background-color: rgb(39, 45, 53); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(76, 86, 98); border-right-color: rgb(76, 86, 98); border-top-color: rgb(76, 86, 98); border-bottom-color: rgb(76, 86, 98); }
.settings-row { flex-direction: row; margin-top: 8px; margin-bottom: 8px; }
.setting-field { flex-grow: 1; min-width: 200px; margin-right: 12px; }
.button-row { flex-direction: row; margin-top: 10px; }
.button-row Button { min-height: 30px; min-width: 140px; margin-right: 8px; }
.primary-button { background-color: rgb(45, 94, 139); color: white; -unity-font-style: bold; }
.status-label { margin-top: 8px; color: rgb(145, 202, 159); }
.status-error { color: rgb(235, 126, 126); }
.result-scroll { flex-grow: 1; min-height: 270px; border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-color: rgb(70, 79, 91); border-right-color: rgb(70, 79, 91); border-bottom-color: rgb(70, 79, 91); }
.result-row { flex-direction: row; min-height: 34px; align-items: center; padding-left: 8px; padding-right: 8px; border-bottom-width: 1px; border-bottom-color: rgb(58, 65, 75); }
.result-row Label { -unity-text-align: middle-center; }
.result-header { background-color: rgb(47, 55, 65); border-top-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: rgb(80, 91, 104); border-left-color: rgb(80, 91, 104); border-right-color: rgb(80, 91, 104); -unity-font-style: bold; }
.result-victory { background-color: rgba(43, 104, 69, 0.35); }
.result-defeat { background-color: rgba(123, 52, 52, 0.35); }
.col-difficulty { width: 90px; }.col-policy { width: 90px; }.col-number { width: 72px; }.col-result { width: 90px; }.col-battles { width: 120px; }
.footnote { margin-top: 10px; color: rgb(142, 151, 162); font-size: 11px; }
