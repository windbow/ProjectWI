  relationshipEventDefinitions:
  - id: relationship_reconciliation
    title:
      uid: REL_RECON_TITLE
      korean: "\uAE68\uC9C4 \uC2E0\uB8B0"
      english: Broken Trust
    description:
      uid: REL_RECON_DESC
      korean: "\uAC08\uB4F1\uD558\uB358 \uB450 \uC778\uBB3C\uC774 \uAC19\uC740 \uC131\uC5D0\uC11C
        \uB2E4\uC2DC \uB9C8\uC8FC\uD588\uC2B5\uB2C8\uB2E4. \uAC70\uB9AC\uB97C \uB458\uC9C0
        \uC18D\uB0B4\uB97C \uD138\uC5B4\uB193\uC744\uC9C0 \uACB0\uC815\uD569\uB2C8\uB2E4."
      english: Two conflicted characters meet again in the same castle.
    requiredLevel: 0
    choices:
    - label:
        uid: REL_RECON_SAFE
        korean: "\uB2F9\uBD84\uAC04 \uAC70\uB9AC\uB97C \uB454\uB2E4"
        english: Keep some distance
      resultDescription:
        uid: REL_RECON_SAFE_RESULT
        korean: "\uAD00\uACC4\uAC00 \uBCF4\uD1B5\uC73C\uB85C \uD68C\uBCF5\uB418\uACE0
          \uACF5\uC801 +2"
        english: Relationship becomes normal and merit +2
      relationshipShift: 1
      meritDelta: 2
      fatigueDelta: 0
    - label:
        uid: REL_RECON_BOLD
        korean: "\uC194\uC9C1\uD558\uAC8C \uB300\uD654\uD55C\uB2E4"
        english: Speak honestly
      resultDescription:
        uid: REL_RECON_BOLD_RESULT
        korean: "\uAD00\uACC4\uAC00 \uCE5C\uC560\uB85C \uD68C\uBCF5\uB418\uACE0 \uACF5\uC801
          +5, \uD53C\uB85C +10"
        english: Relationship becomes fondness, merit +5, fatigue +10
      relationshipShift: 2
      meritDelta: 5
      fatigueDelta: 10
  - id: relationship_shared_oath
    title:
      uid: REL_OATH_TITLE
      korean: "\uD568\uAED8 \uC138\uC6B4 \uB9F9\uC138"
      english: A Shared Oath
    description:
      uid: REL_OATH_DESC
      korean: "\uC11C\uB85C\uB97C \uC2E0\uB8B0\uD558\uB294 \uB450 \uC778\uBB3C\uC774
        \uC55E\uC73C\uB85C\uC758 \uD611\uB825 \uBC29\uC2DD\uC744 \uC815\uD558\uB824
        \uD569\uB2C8\uB2E4."
      english: Two trusted characters decide how they will cooperate.
    requiredLevel: 2
    choices:
    - label:
