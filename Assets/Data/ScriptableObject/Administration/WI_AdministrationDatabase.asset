  heroLegacyDefinitions:
  - id: legacy_prosperity
    projectType: 0
    displayName:
      uid: legacy_prosperity_name
      korean: "\uD48D\uC694\uC758 \uACE1\uCC3D"
      english: Granary of Plenty
    description:
      uid: legacy_prosperity_description
      korean: "\uBC88\uC601 \uC0AC\uC5C5 \uC131\uACFC\uB97C \uB192\uC774\uB294 \uC601\uC6C5\uC758
        \uC6B4\uC601 \uC804\uD1B5\uC785\uB2C8\uB2E4."
      english: A heroic tradition that improves prosperity projects.
    projectGainBonus: 2
  - id: legacy_technology
