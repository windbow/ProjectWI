      korean: "\uBAA8\uB4E0 \uC911\uC810 \uC0AC\uC5C5 \uC131\uACFC\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
      english: Improves all focus projects.
    manaCost: 140
    requiredTechnology: 45
    durationMonths: 2
    effectType: 3
    effectValue: 2
    prerequisiteResearchId: mana_circulation
  - id: battle_enchantment
    displayName:
      uid: RESEARCH_BATTLE_ENCHANT
      korean: "\uC804\uD22C \uB9C8\uBC95 \uBD80\uC5EC"
      english: Battle Enchantment
    description:
      uid: RESEARCH_BATTLE_ENCHANT_DESC
      korean: "\uBAA8\uB4E0 \uBD80\uB300\uC758 \uC804\uD22C\uB825\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
      english: Increases battle power of every army.
    manaCost: 180
    requiredTechnology: 55
    durationMonths: 3
    effectType: 4
    effectValue: 15
    prerequisiteResearchId: arcane_administration
  - id: diplomatic_seals
    displayName:
      uid: RESEARCH_DIPLOMATIC_SEALS
      korean: "\uB9C8\uB3C4 \uC778\uC7A5 \uC678\uAD50"
      english: Arcane Seals
    description:
      uid: RESEARCH_DIPLOMATIC_SEALS_DESC
      korean: "\uAC01 \uC131\uC758 \uC601\uD5A5\uB825 \uC218\uC785\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
      english: Increases influence income in every castle.
    manaCost: 120
    requiredTechnology: 40
    durationMonths: 2
    effectType: 2
    effectValue: 1
    prerequisiteResearchId: mana_circulation
  titleDefinitions:
  - id: retainer
    displayName:
      uid: TITLE_RETAINER
      korean: "\uC655\uC2E4 \uC885\uC0AC"
      english: Royal Retainer
    requiredMerit: 10
    influenceCost: 10
    projectBonus: 1
    battlePowerBonus: 0
  - id: knight
    displayName:
      uid: TITLE_KNIGHT
      korean: "\uAE30\uC0AC"
      english: Knight
    requiredMerit: 30
    influenceCost: 20
    projectBonus: 0
    battlePowerBonus: 8
  - id: baron
    displayName:
      uid: TITLE_BARON
      korean: "\uB0A8\uC791"
      english: Baron
    requiredMerit: 60
    influenceCost: 35
    projectBonus: 2
    battlePowerBonus: 5
  - id: count
    displayName:
      uid: TITLE_COUNT
      korean: "\uBC31\uC791"
      english: Count
    requiredMerit: 100
    influenceCost: 60
    projectBonus: 3
    battlePowerBonus: 10
  schemeDefinitions:
  - id: scheme_investigation
    displayName:
      uid: SCHEME_INVESTIGATION
      korean: "\uC870\uC0AC"
      english: Investigation
    description:
      uid: SCHEME_INVESTIGATION_DESC
      korean: "\uC801 \uC131\uC758 \uC218\uCE58\uC640 \uC8FC\uB454 \uC778\uBB3C\uC744
        3\uAC1C\uC6D4\uAC04 \uD655\uC778\uD569\uB2C8\uB2E4."
      english: "\uC801 \uC131\uC758 \uC218\uCE58\uC640 \uC8FC\uB454 \uC778\uBB3C\uC744
        3\uAC1C\uC6D4\uAC04 \uD655\uC778\uD569\uB2C8\uB2E4."
    schemeType: 0
    influenceCost: 10
    baseSuccessChance: 50
    effectValue: 0
    durationMonths: 3
    baseDetectionChance: 20
    failureDetectionBonus: 25
  - id: scheme_counterintelligence
    displayName:
      uid: SCHEME_COUNTERINTELLIGENCE
      korean: "\uBC29\uCCA9"
      english: Counterintelligence
    description:
      uid: SCHEME_COUNTERINTELLIGENCE_DESC
      korean: "\uC544\uAD70 \uC131\uC744 3\uAC1C\uC6D4\uAC04 \uC801 \uC870\uC0AC\uC640
        \uACC4\uB7B5\uC73C\uB85C\uBD80\uD130 \uBCF4\uD638\uD569\uB2C8\uB2E4."
      english: "\uC544\uAD70 \uC131\uC744 3\uAC1C\uC6D4\uAC04 \uC801 \uC870\uC0AC\uC640
        \uACC4\uB7B5\uC73C\uB85C\uBD80\uD130 \uBCF4\uD638\uD569\uB2C8\uB2E4."
    schemeType: 1
    influenceCost: 10
    baseSuccessChance: 100
    effectValue: 0
    durationMonths: 3
    baseDetectionChance: 0
    failureDetectionBonus: 0
  - id: scheme_rumor
    displayName:
      uid: SCHEME_RUMOR
      korean: "\uC720\uC5B8\uBE44\uC5B4"
      english: Rumor
    description:
      uid: SCHEME_RUMOR_DESC
      korean: "\uC801 \uC131\uC758 \uCE58\uC548\uC744 10 \uB0AE\uCDA5\uB2C8\uB2E4."
      english: "\uC801 \uC131\uC758 \uCE58\uC548\uC744 10 \uB0AE\uCDA5\uB2C8\uB2E4."
    schemeType: 2
    influenceCost: 15
    baseSuccessChance: 45
    effectValue: 10
    durationMonths: 0
    baseDetectionChance: 30
    failureDetectionBonus: 25
  - id: scheme_alienation
    displayName:
      uid: SCHEME_ALIENATION
      korean: "\uC778\uC7AC \uC774\uAC04"
      english: Alienation
    description:
      uid: SCHEME_ALIENATION_DESC
      korean: "\uC801 \uC131 \uC778\uBB3C\uC758 \uCDA9\uC131 \uC0C1\uD0DC\uB97C \uD55C
        \uB2E8\uACC4 \uD754\uB4ED\uB2C8\uB2E4."
      english: "\uC801 \uC131 \uC778\uBB3C\uC758 \uCDA9\uC131 \uC0C1\uD0DC\uB97C
        \uD55C \uB2E8\uACC4 \uD754\uB4ED\uB2C8\uB2E4."
    schemeType: 3
    influenceCost: 20
    baseSuccessChance: 35
    effectValue: 1
    durationMonths: 0
    baseDetectionChance: 35
    failureDetectionBonus: 30
  difficultyDefinitions:
  - difficulty: 0
    displayName:
      uid: DIFFICULTY_STANDARD
      korean: "\uD45C\uC900"
      english: Standard
    description:
      uid: DIFFICULTY_STANDARD_DESC
      korean: "\uCD94\uCC9C \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4. AI\uAC00 \uC0C1\uC704
        \uB450 \uD6C4\uBCF4 \uC548\uC5D0\uC11C \uC0C1\uD669\uC5D0 \uB9DE\uB294 \uACB0\uC815\uC744
        \uB0B4\uB9BD\uB2C8\uB2E4."
      english: "\uCD94\uCC9C \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4. AI\uAC00 \uC0C1\uC704
        \uB450 \uD6C4\uBCF4 \uC548\uC5D0\uC11C \uC0C1\uD669\uC5D0 \uB9DE\uB294 \uACB0\uC815\uC744
        \uB0B4\uB9BD\uB2C8\uB2E4."
    aiCandidateWindow: 2
  - difficulty: 1
    displayName:
      uid: DIFFICULTY_RELAXED
      korean: "\uC5EC\uC720"
      english: Relaxed
    description:
      uid: DIFFICULTY_RELAXED_DESC
      korean: "\uC804\uB7B5 \uD559\uC2B5\uC5D0 \uC801\uD569\uD569\uB2C8\uB2E4. AI\uAC00
        \uC0C1\uC704 \uC138 \uD6C4\uBCF4\uB97C \uD3ED\uB113\uAC8C \uAC80\uD1A0\uD574
        \uCD5C\uC801 \uC120\uD0DD \uBE48\uB3C4\uAC00 \uB0AE\uC2B5\uB2C8\uB2E4."
      english: "\uC804\uB7B5 \uD559\uC2B5\uC5D0 \uC801\uD569\uD569\uB2C8\uB2E4. AI\uAC00
        \uC0C1\uC704 \uC138 \uD6C4\uBCF4\uB97C \uD3ED\uB113\uAC8C \uAC80\uD1A0\uD574
        \uCD5C\uC801 \uC120\uD0DD \uBE48\uB3C4\uAC00 \uB0AE\uC2B5\uB2C8\uB2E4."
    aiCandidateWindow: 3
  - difficulty: 2
    displayName:
      uid: DIFFICULTY_HARD
      korean: "\uB3C4\uC804"
      english: Hard
    description:
      uid: DIFFICULTY_HARD_DESC
      korean: "\uC219\uB828\uC790\uB97C \uC704\uD55C \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4.
        AI\uAC00 \uC228\uC740 \uBCF4\uB108\uC2A4 \uC5C6\uC774 \uD56D\uC0C1 \uCD5C\uC0C1\uC704
        \uD6C4\uBCF4\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4."
      english: "\uC219\uB828\uC790\uB97C \uC704\uD55C \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4.
        AI\uAC00 \uC228\uC740 \uBCF4\uB108\uC2A4 \uC5C6\uC774 \uD56D\uC0C1 \uCD5C\uC0C1\uC704
        \uD6C4\uBCF4\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4."
    aiCandidateWindow: 1
  tutorialDefinitions:
  - id: tutorial_global
    month: 1
    title:
      uid: tutorial_global_title
      korean: "\uB300\uB959\uACFC \uB2E4\uC74C \uD134"
      english: Continent and Next Turn
    description:
      uid: tutorial_global_description
      korean: "\uB300\uB959 \uC9C0\uB3C4\uC5D0\uC11C 60\uAC1C \uC131\uACFC \uC138\uB825
        \uACBD\uACC4\uB97C \uC0B4\uD3B4\uBCF4\uC2ED\uC2DC\uC624. \uD558\uB2E8 \uC804\uC5ED
        \uBA54\uB274\uB85C \uC138\uB825 \uBA85\uB839\uC744 \uC5F4\uACE0, \uC900\uBE44\uAC00
        \uB05D\uB098\uBA74 \uC6B0\uCE21\uC758 \uB2E4\uC74C \uD134\uC73C\uB85C \uD55C
        \uB2EC\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4."
      english: Review the 60 castles and faction borders. Use the global menus for
        faction commands, then advance one month with Next Turn.
  - id: tutorial_castle
    month: 2
    title:
      uid: tutorial_castle_title
      korean: "\uC131 \uC911\uC2EC \uB0B4\uC815"
      english: Castle Administration
    description:
      uid: tutorial_castle_description
      korean: "\uC9C0\uB3C4\uC5D0\uC11C \uC544\uBC1C\uB860\uC758 \uC131\uC744 \uC120\uD0DD\uD558\uBA74
        \uC131 \uD654\uBA74\uC73C\uB85C \uC804\uD658\uB429\uB2C8\uB2E4. \uC131 \uC218\uCE58,
        \uD0DC\uC218\uC640 \uC8FC\uB454 \uC778\uBB3C\uC744 \uD655\uC778\uD55C \uB4A4
        \uB300\uB959 \uC9C0\uB3C4\uB85C \uB3CC\uC544\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      english: Select an Avalon castle on the map to enter its administration view.
        Review its values, governor and stationed characters, then return to the
        continent.
  - id: tutorial_project
    month: 3
    title:
      uid: tutorial_project_title
      korean: "\uC774\uBC88 \uB2EC \uC911\uC810 \uC0AC\uC5C5"
      english: Monthly Focus Project
    description:
      uid: tutorial_project_description
      korean: "\uC131 \uD654\uBA74\uC758 \uC911\uC810 \uC0AC\uC5C5\uC5D0\uC11C \uBC88\uC601\xB7\uAE30\uC220\xB7\uC548\uC815\xB7\uC694\uC0C8
        \uB4F1 \uBAA9\uD45C\uC640 \uB2F4\uB2F9 \uC778\uBB3C\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4.
        \uB2F4\uB2F9 \uC778\uBB3C\uC740 \uC644\uB8CC\uB420 \uB54C\uAE4C\uC9C0 \uB2E4\uB978
        \uC784\uBB34\uB97C \uB9E1\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      english: Choose a focus and manager from the castle project menu. The manager
        cannot take another duty until the project finishes.
  - id: tutorial_research
    month: 6
    title:
      uid: tutorial_research_title
      korean: "\uC5F0\uAD6C\uC640 \uC778\uBB3C \uBC30\uC815"
      english: Research and Assignment
    description:
      uid: tutorial_research_description
      korean: "\uC804\uC5ED \uC5F0\uAD6C \uBA54\uB274\uC5D0\uC11C \uB9C8\uB098\uC640
        \uAE30\uC220 \uC870\uAC74\uC744 \uD655\uC778\uD558\uC2ED\uC2DC\uC624. \uB300\uAE30
        \uC778\uBB3C\uC744 \uC5F0\uAD6C \uB2F4\uB2F9\uC790\uB85C \uC9C0\uC815\uD558\uBA74
        \uC644\uB8CC \uD6C4 \uC138\uB825 \uC804\uCCB4\uC5D0 \uD6A8\uACFC\uAC00 \uC801\uC6A9\uB429\uB2C8\uB2E4."
      english: Check mana and technology requirements in the global research menu.
        Assign an idle character to unlock a faction-wide effect.
  - id: tutorial_military
    month: 12
    title:
      uid: tutorial_military_title
      korean: "\uAD70\uC0AC\uC640 \uCCAB\uD574 \uC810\uAC80"
      english: Military and First-Year Review
    description:
      uid: tutorial_military_description
      korean: "\uAD70\uC0AC \uBA54\uB274\uC5D0\uC11C \uBD80\uB300\uB97C \uD3B8\uC131\uD558\uACE0
        \uC778\uC811 \uC131\uC73C\uB85C \uC774\uB3D9\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4.
        \uCD9C\uC815 \uC804 \uC5ED\uD560\xB7\uBCF4\uAE09\xB7\uC219\uB828\uACFC \uC678\uAD50\uC758
        \uC804\uC7C1 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
      english: Form armies and move them to adjacent castles. Before marching, review
        roles, supply, proficiency and diplomatic war status.
  campaignRules:
    victoryRequiresAllCastles: 1
    defeatWhenNoCastles: 1
    victoryTitle:
      uid: campaign_victory_title
      korean: "\uB300\uB959 \uD1B5\uC77C"
      english: Continental Unification
    victoryDescription:
      uid: campaign_victory_description
      korean: "\uC544\uBC1C\uB860\uC774 \uB300\uB959\uC758 \uBAA8\uB4E0 \uC131\uC744
        \uD1B5\uC77C\uD588\uC2B5\uB2C8\uB2E4. \uD669\uD63C\uC758 \uADC0\uD658 \uCEA0\uD398\uC778\uC758
        \uCD5C\uC18C \uC2B9\uB9AC \uC870\uAC74\uC744 \uB2EC\uC131\uD588\uC2B5\uB2C8\uB2E4."
      english: Avalon controls every castle on the continent and has achieved the
        campaign's minimum victory condition.
    defeatTitle:
      uid: campaign_defeat_title
      korean: "\uC544\uBC1C\uB860 \uBA78\uB9DD"
      english: Fall of Avalon
    defeatDescription:
      uid: campaign_defeat_description
      korean: "\uC544\uBC1C\uB860\uC774 \uC9C0\uBC30\uD558\uB294 \uC131\uC774 \uD558\uB098\uB3C4
        \uB0A8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC138\uB825\uC744 \uC7AC\uAC74\uD560
        \uAE30\uBC18\uC744 \uC783\uC5C8\uC2B5\uB2C8\uB2E4."
      english: Avalon controls no castles and has lost the foundation needed to rebuild
        the faction.
  campaignObjectives:
  - id: avalon_restore_capital
    title:
      uid: OBJECTIVE_AVALON_RESTORE_TITLE
      korean: "\uBCC4\uBE5B \uC218\uB3C4\uC758 \uC7AC\uAC74"
      english: Restore the Starlit Capital
    situation:
      uid: OBJECTIVE_AVALON_RESTORE_SITUATION
      korean: "\uD669\uD63C\uC758 \uADC0\uD658 \uC774\uD6C4 \uC544\uBC1C\uB860\uC758
        \uAD6D\uACBD\uC740 \uAC08\uB77C\uC84C\uACE0 \uBC1C\uB3C4\uB974\uC758 \uC555\uBC15\uC774
        \uB3D9\uBD80 \uAD00\uBB38\uAE4C\uC9C0 \uB2E4\uAC00\uC654\uC2B5\uB2C8\uB2E4.
        \uC6D0\uC815\uC744 \uC11C\uB450\uB974\uAE30 \uC804\uC5D0 \uC218\uB3C4\uC758
        \uBBFC\uC0DD\uACFC \uC138\uC785 \uAE30\uBC18\uC744 \uD68C\uBCF5\uD574\uC57C
        \uD569\uB2C8\uB2E4."
      english: After the Twilight Return Avalon's borders are fractured and Valdor
        presses toward the eastern gate. Restore the capital before committing to
        war.
    description:
      uid: OBJECTIVE_AVALON_RESTORE_DESC
      korean: "\uC544\uBC1C\uB860 \uC131\uC758 \uBC88\uC601\uC744 50 \uC774\uC0C1\uC73C\uB85C
        \uC62C\uB9AC\uC2ED\uC2DC\uC624. \uC218\uB3C4\uC5D0\uC11C \uBC88\uC601 \uC0AC\uC5C5\uC744
        \uC9C0\uC815\uD558\uACE0 \uB2E4\uC74C \uD134\uC744 \uC9C4\uD589\uD558\uBA74
        \uBAA9\uD45C\uB97C \uB2EC\uC131\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      english: Raise Avalon Castle prosperity to at least 50. Assign a prosperity
        project in the capital and advance the turn.
    objectiveType: 0
    targetCastleId: castle_00
    targetFactionId: 
    targetValue: 50
    rewardGold: 200
    rewardMana: 50
    rewardInfluence: 20
  - id: avalon_secure_border
    title:
      uid: OBJECTIVE_AVALON_BORDER_TITLE
      korean: "\uC11C\uBD80 \uAD6D\uACBD\uC120 \uD655\uBCF4"
      english: Secure the Western Border
    situation:
      uid: OBJECTIVE_AVALON_BORDER_SITUATION
      korean: "\uC218\uB3C4\uB294 \uC548\uC815\uC744 \uB418\uCC3E\uC558\uC9C0\uB9CC
        \uC544\uBC1C\uB860\uC740 \uACE0\uB9BD\uB41C \uD55C \uAC1C \uC131\uC5D0 \uBA38\uBB3C\uB7EC
        \uC788\uC2B5\uB2C8\uB2E4."
      english: The capital is stable but Avalon remains isolated in a single castle.
    description:
      uid: OBJECTIVE_AVALON_BORDER_DESC
      korean: "\uC544\uBC1C\uB860\uC774 \uC18C\uC720\uD55C \uC131\uC744 3\uAC1C \uC774\uC0C1\uC73C\uB85C
        \uB298\uB9AC\uC2ED\uC2DC\uC624."
      english: Expand Avalon to at least three castles.
    objectiveType: 1
    targetCastleId: 
    targetFactionId: 
    targetValue: 3
    rewardGold: 350
    rewardMana: 80
    rewardInfluence: 40
  - id: avalon_break_valdor
    title:
      uid: OBJECTIVE_AVALON_VALDOR_TITLE
      korean: "\uBD89\uC740 \uC81C\uAD6D\uC758 \uCC3D\uC744 \uAEBE\uB2E4"
      english: Break the Red Empire
    situation:
      uid: OBJECTIVE_AVALON_VALDOR_SITUATION
      korean: "\uAD6D\uACBD\uC740 \uB113\uC5B4\uC84C\uC9C0\uB9CC \uBC1C\uB3C4\uB974
        \uC81C\uAD6D\uC774 \uC544\uBC1C\uB860\uC758 \uC7AC\uAC74\uC744 \uACC4\uC18D
        \uC704\uD611\uD569\uB2C8\uB2E4."
      english: The border has widened but Valdor still threatens Avalon's restoration.
    description:
      uid: OBJECTIVE_AVALON_VALDOR_DESC
      korean: "\uBC1C\uB3C4\uB974 \uC81C\uAD6D\uC758 \uBAA8\uB4E0 \uC131\uC744 \uC810\uB839\uD574
        \uC138\uB825\uC744 \uBA78\uB9DD\uC2DC\uD0A4\uC2ED\uC2DC\uC624."
      english: Capture every Valdor castle and eliminate the faction.
    objectiveType: 2
    targetCastleId: 
    targetFactionId: valdor
    targetValue: 1
    rewardGold: 600
    rewardMana: 150
    rewardInfluence: 80
  - id: avalon_unify_continent
    title:
      uid: OBJECTIVE_AVALON_UNIFY_TITLE
      korean: "\uD669\uD63C\uC758 \uB300\uB959 \uD1B5\uC77C"
      english: Unify the Twilight Continent
    situation:
      uid: OBJECTIVE_AVALON_UNIFY_SITUATION
      korean: "\uBC1C\uB3C4\uB974\uC758 \uBAB0\uB77D\uC73C\uB85C \uC138\uB825 \uADE0\uD615\uC774
        \uBB34\uB108\uC84C\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uB300\uB959\uC758 \uC804\uC7C1\uC744
        \uB05D\uB0BC \uB54C\uC785\uB2C8\uB2E4."
      english: Valdor's fall has broken the balance of power. It is time to end the
        continental war.
    description:
      uid: OBJECTIVE_AVALON_UNIFY_DESC
      korean: "\uB300\uB959\uC758 60\uAC1C \uC131\uC744 \uBAA8\uB450 \uC544\uBC1C\uB860\uC758
        \uC9C0\uBC30 \uC544\uB798 \uB450\uC2ED\uC2DC\uC624."
      english: Bring all sixty castles under Avalon rule.
    objectiveType: 3
    targetCastleId: 
