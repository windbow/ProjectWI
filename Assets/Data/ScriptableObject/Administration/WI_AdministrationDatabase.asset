    projectBonus: 3
    battlePowerBonus: 10
  schemeDefinitions:
  - id: scheme_investigation
    displayName:
      uid: SCHEME_INVESTIGATION
      korean: "\uC870\uC0AC"
      english: Investigation
    description:
      uid: SCHEME_INVESTIGATION_DESC
      korean: "\uC801 \uC131\uC758 \uC218\uCE58\uC640 \uC8FC\uB454 \uC778\uBB3C\uC744
        3\uAC1C\uC6D4\uAC04 \uD655\uC778\uD569\uB2C8\uB2E4."
      english: "\uC801 \uC131\uC758 \uC218\uCE58\uC640 \uC8FC\uB454 \uC778\uBB3C\uC744
        3\uAC1C\uC6D4\uAC04 \uD655\uC778\uD569\uB2C8\uB2E4."
    schemeType: 0
    influenceCost: 10
    baseSuccessChance: 50
    effectValue: 0
    durationMonths: 3
  - id: scheme_counterintelligence
    displayName:
      uid: SCHEME_COUNTERINTELLIGENCE
      korean: "\uBC29\uCCA9"
      english: Counterintelligence
    description:
      uid: SCHEME_COUNTERINTELLIGENCE_DESC
      korean: "\uC544\uAD70 \uC131\uC744 3\uAC1C\uC6D4\uAC04 \uC801 \uC870\uC0AC\uC640
        \uACC4\uB7B5\uC73C\uB85C\uBD80\uD130 \uBCF4\uD638\uD569\uB2C8\uB2E4."
      english: "\uC544\uAD70 \uC131\uC744 3\uAC1C\uC6D4\uAC04 \uC801 \uC870\uC0AC\uC640
        \uACC4\uB7B5\uC73C\uB85C\uBD80\uD130 \uBCF4\uD638\uD569\uB2C8\uB2E4."
    schemeType: 1
    influenceCost: 10
    baseSuccessChance: 100
    effectValue: 0
    durationMonths: 3
  - id: scheme_rumor
    displayName:
      uid: SCHEME_RUMOR
      korean: "\uC720\uC5B8\uBE44\uC5B4"
      english: Rumor
    description:
      uid: SCHEME_RUMOR_DESC
      korean: "\uC801 \uC131\uC758 \uCE58\uC548\uC744 10 \uB0AE\uCDA5\uB2C8\uB2E4."
      english: "\uC801 \uC131\uC758 \uCE58\uC548\uC744 10 \uB0AE\uCDA5\uB2C8\uB2E4."
    schemeType: 2
    influenceCost: 15
    baseSuccessChance: 45
    effectValue: 10
    durationMonths: 0
  - id: scheme_alienation
    displayName:
      uid: SCHEME_ALIENATION
      korean: "\uC778\uC7AC \uC774\uAC04"
      english: Alienation
    description:
      uid: SCHEME_ALIENATION_DESC
      korean: "\uC801 \uC131 \uC778\uBB3C\uC758 \uCDA9\uC131 \uC0C1\uD0DC\uB97C \uD55C
        \uB2E8\uACC4 \uD754\uB4ED\uB2C8\uB2E4."
      english: "\uC801 \uC131 \uC778\uBB3C\uC758 \uCDA9\uC131 \uC0C1\uD0DC\uB97C
        \uD55C \uB2E8\uACC4 \uD754\uB4ED\uB2C8\uB2E4."
    schemeType: 3
    influenceCost: 20
    baseSuccessChance: 35
    effectValue: 1
    durationMonths: 0
  difficultyDefinitions:
  - difficulty: 0
    displayName:
      uid: DIFFICULTY_STANDARD
      korean: "\uD45C\uC900"
      english: Standard
    description:
      uid: DIFFICULTY_STANDARD_DESC
      korean: "\uCD94\uCC9C \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4. AI\uAC00 \uC0C1\uC704
        \uB450 \uD6C4\uBCF4 \uC548\uC5D0\uC11C \uC0C1\uD669\uC5D0 \uB9DE\uB294 \uACB0\uC815\uC744
        \uB0B4\uB9BD\uB2C8\uB2E4."
      english: "\uCD94\uCC9C \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4. AI\uAC00 \uC0C1\uC704
        \uB450 \uD6C4\uBCF4 \uC548\uC5D0\uC11C \uC0C1\uD669\uC5D0 \uB9DE\uB294 \uACB0\uC815\uC744
        \uB0B4\uB9BD\uB2C8\uB2E4."
    aiCandidateWindow: 2
  - difficulty: 1
    displayName:
      uid: DIFFICULTY_RELAXED
      korean: "\uC5EC\uC720"
      english: Relaxed
    description:
      uid: DIFFICULTY_RELAXED_DESC
      korean: "\uC804\uB7B5 \uD559\uC2B5\uC5D0 \uC801\uD569\uD569\uB2C8\uB2E4. AI\uAC00
        \uC0C1\uC704 \uC138 \uD6C4\uBCF4\uB97C \uD3ED\uB113\uAC8C \uAC80\uD1A0\uD574
        \uCD5C\uC801 \uC120\uD0DD \uBE48\uB3C4\uAC00 \uB0AE\uC2B5\uB2C8\uB2E4."
      english: "\uC804\uB7B5 \uD559\uC2B5\uC5D0 \uC801\uD569\uD569\uB2C8\uB2E4. AI\uAC00
        \uC0C1\uC704 \uC138 \uD6C4\uBCF4\uB97C \uD3ED\uB113\uAC8C \uAC80\uD1A0\uD574
        \uCD5C\uC801 \uC120\uD0DD \uBE48\uB3C4\uAC00 \uB0AE\uC2B5\uB2C8\uB2E4."
    aiCandidateWindow: 3
  - difficulty: 2
    displayName:
      uid: DIFFICULTY_HARD
      korean: "\uB3C4\uC804"
      english: Hard
    description:
      uid: DIFFICULTY_HARD_DESC
      korean: "\uC219\uB828\uC790\uB97C \uC704\uD55C \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4.
        AI\uAC00 \uC228\uC740 \uBCF4\uB108\uC2A4 \uC5C6\uC774 \uD56D\uC0C1 \uCD5C\uC0C1\uC704
        \uD6C4\uBCF4\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4."
      english: "\uC219\uB828\uC790\uB97C \uC704\uD55C \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4.
        AI\uAC00 \uC228\uC740 \uBCF4\uB108\uC2A4 \uC5C6\uC774 \uD56D\uC0C1 \uCD5C\uC0C1\uC704
        \uD6C4\uBCF4\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4."
    aiCandidateWindow: 1
  tutorialDefinitions:
  - id: tutorial_global
    month: 1
    title:
      uid: tutorial_global_title
      korean: "\uB300\uB959\uACFC \uB2E4\uC74C \uD134"
      english: Continent and Next Turn
    description:
      uid: tutorial_global_description
      korean: "\uB300\uB959 \uC9C0\uB3C4\uC5D0\uC11C 60\uAC1C \uC131\uACFC \uC138\uB825
        \uACBD\uACC4\uB97C \uC0B4\uD3B4\uBCF4\uC2ED\uC2DC\uC624. \uD558\uB2E8 \uC804\uC5ED
        \uBA54\uB274\uB85C \uC138\uB825 \uBA85\uB839\uC744 \uC5F4\uACE0, \uC900\uBE44\uAC00
        \uB05D\uB098\uBA74 \uC6B0\uCE21\uC758 \uB2E4\uC74C \uD134\uC73C\uB85C \uD55C
        \uB2EC\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4."
      english: Review the 60 castles and faction borders. Use the global menus for
        faction commands, then advance one month with Next Turn.
  - id: tutorial_castle
    month: 2
    title:
      uid: tutorial_castle_title
      korean: "\uC131 \uC911\uC2EC \uB0B4\uC815"
      english: Castle Administration
    description:
      uid: tutorial_castle_description
      korean: "\uC9C0\uB3C4\uC5D0\uC11C \uC544\uBC1C\uB860\uC758 \uC131\uC744 \uC120\uD0DD\uD558\uBA74
        \uC131 \uD654\uBA74\uC73C\uB85C \uC804\uD658\uB429\uB2C8\uB2E4. \uC131 \uC218\uCE58,
        \uD0DC\uC218\uC640 \uC8FC\uB454 \uC778\uBB3C\uC744 \uD655\uC778\uD55C \uB4A4
        \uB300\uB959 \uC9C0\uB3C4\uB85C \uB3CC\uC544\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      english: Select an Avalon castle on the map to enter its administration view.
        Review its values, governor and stationed characters, then return to the
        continent.
  - id: tutorial_project
    month: 3
    title:
      uid: tutorial_project_title
      korean: "\uC774\uBC88 \uB2EC \uC911\uC810 \uC0AC\uC5C5"
      english: Monthly Focus Project
    description:
      uid: tutorial_project_description
      korean: "\uC131 \uD654\uBA74\uC758 \uC911\uC810 \uC0AC\uC5C5\uC5D0\uC11C \uBC88\uC601\xB7\uAE30\uC220\xB7\uC548\uC815\xB7\uC694\uC0C8
        \uB4F1 \uBAA9\uD45C\uC640 \uB2F4\uB2F9 \uC778\uBB3C\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4.
        \uB2F4\uB2F9 \uC778\uBB3C\uC740 \uC644\uB8CC\uB420 \uB54C\uAE4C\uC9C0 \uB2E4\uB978
        \uC784\uBB34\uB97C \uB9E1\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      english: Choose a focus and manager from the castle project menu. The manager
        cannot take another duty until the project finishes.
  - id: tutorial_research
    month: 6
    title:
      uid: tutorial_research_title
      korean: "\uC5F0\uAD6C\uC640 \uC778\uBB3C \uBC30\uC815"
      english: Research and Assignment
    description:
      uid: tutorial_research_description
      korean: "\uC804\uC5ED \uC5F0\uAD6C \uBA54\uB274\uC5D0\uC11C \uB9C8\uB098\uC640
        \uAE30\uC220 \uC870\uAC74\uC744 \uD655\uC778\uD558\uC2ED\uC2DC\uC624. \uB300\uAE30
        \uC778\uBB3C\uC744 \uC5F0\uAD6C \uB2F4\uB2F9\uC790\uB85C \uC9C0\uC815\uD558\uBA74
        \uC644\uB8CC \uD6C4 \uC138\uB825 \uC804\uCCB4\uC5D0 \uD6A8\uACFC\uAC00 \uC801\uC6A9\uB429\uB2C8\uB2E4."
      english: Check mana and technology requirements in the global research menu.
        Assign an idle character to unlock a faction-wide effect.
  - id: tutorial_military
    month: 12
    title:
      uid: tutorial_military_title
      korean: "\uAD70\uC0AC\uC640 \uCCAB\uD574 \uC810\uAC80"
      english: Military and First-Year Review
    description:
      uid: tutorial_military_description
      korean: "\uAD70\uC0AC \uBA54\uB274\uC5D0\uC11C \uBD80\uB300\uB97C \uD3B8\uC131\uD558\uACE0
        \uC778\uC811 \uC131\uC73C\uB85C \uC774\uB3D9\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4.
        \uCD9C\uC815 \uC804 \uC5ED\uD560\xB7\uBCF4\uAE09\xB7\uC219\uB828\uACFC \uC678\uAD50\uC758
        \uC804\uC7C1 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
      english: Form armies and move them to adjacent castles. Before marching, review
        roles, supply, proficiency and diplomatic war status.
  campaignRules:
    victoryRequiresAllCastles: 1
    defeatWhenNoCastles: 1
    victoryTitle:
      uid: campaign_victory_title
      korean: "\uB300\uB959 \uD1B5\uC77C"
      english: Continental Unification
    victoryDescription:
      uid: campaign_victory_description
      korean: "\uC544\uBC1C\uB860\uC774 \uB300\uB959\uC758 \uBAA8\uB4E0 \uC131\uC744
        \uD1B5\uC77C\uD588\uC2B5\uB2C8\uB2E4. \uD669\uD63C\uC758 \uADC0\uD658 \uCEA0\uD398\uC778\uC758
        \uCD5C\uC18C \uC2B9\uB9AC \uC870\uAC74\uC744 \uB2EC\uC131\uD588\uC2B5\uB2C8\uB2E4."
      english: Avalon controls every castle on the continent and has achieved the
        campaign's minimum victory condition.
    defeatTitle:
      uid: campaign_defeat_title
      korean: "\uC544\uBC1C\uB860 \uBA78\uB9DD"
      english: Fall of Avalon
    defeatDescription:
      uid: campaign_defeat_description
      korean: "\uC544\uBC1C\uB860\uC774 \uC9C0\uBC30\uD558\uB294 \uC131\uC774 \uD558\uB098\uB3C4
        \uB0A8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC138\uB825\uC744 \uC7AC\uAC74\uD560
        \uAE30\uBC18\uC744 \uC783\uC5C8\uC2B5\uB2C8\uB2E4."
      english: Avalon controls no castles and has lost the foundation needed to rebuild
        the faction.
  projectBalance:
    basicCost: 100
    intensiveCost: 180
    expansionBasicCost: 600
    baseGain: 4
    statDivisor: 20
    intensiveGainBonus: 4
    traitGainBonus: 2
    policyGainBonus: 2
    minimumGain: 4
    maximumGain: 16
    expansionDurationMonths: 3
  traitDefinitions:
  - traitType: 0
    displayName:
      uid: trait_0_name
      korean: "\uB18D\uC815\uAC00"
      english: Agronomist
    description:
      uid: trait_0_description
      korean: "\uBC88\uC601 \uC0AC\uC5C5 \uC131\uACFC +2 \xB7 \uC8FC\uB454 \uBD80\uB300\uC758
        \uBCF4\uAE09\uC744 \uCDA9\uBD84 \uC0C1\uD0DC\uB85C \uD68C\uBCF5"
      english: "Prosperity +2 \xB7 restores stationed armies to sufficient supply"
    projectTypes: 00000000
    uniqueEffectValue: 1
  - traitType: 1
    displayName:
      uid: trait_1_name
      korean: "\uC0C1\uC778"
      english: Merchant
    description:
      uid: trait_1_description
      korean: "\uBC88\uC601 \uC0AC\uC5C5 \uC131\uACFC +2 \xB7 \uC0AC\uC5C5 \uC644\uB8CC
        \uC2DC \uCD94\uAC00 \uAE08\uD654 50 \uD68D\uB4DD"
      english: "Prosperity +2 \xB7 gains 50 additional gold on completion"
    projectTypes: 00000000
    uniqueEffectValue: 50
  - traitType: 2
    displayName:
      uid: trait_2_name
      korean: "\uAC74\uCD95\uAC00"
      english: Architect
    description:
      uid: trait_2_description
      korean: "\uC694\uC0C8\xB7\uD655\uC7A5 \uC0AC\uC5C5 \uC131\uACFC +2 \xB7 \uC0AC\uC5C5
        \uC644\uB8CC \uC2DC \uACF5\uC0AC\uBE44 15% \uD658\uAE09"
      english: "Fortification/expansion +2 \xB7 refunds 15% of project cost"
    projectTypes: 0300000007000000
    uniqueEffectValue: 15
  - traitType: 3
    displayName:
      uid: trait_3_name
      korean: "\uCE58\uC548\uAD00"
      english: Constable
    description:
      uid: trait_3_description
      korean: "\uC548\uC815 \uC0AC\uC5C5 \uC131\uACFC +2 \xB7 \uC0AC\uC5C5 \uC644\uB8CC
        \uC2DC \uBC29\uCCA9\uC744 2\uAC1C\uC6D4 \uAC15\uD654"
      english: "Stability +2 \xB7 strengthens counterintelligence for 2 months"
    projectTypes: 02000000
    uniqueEffectValue: 2
  - traitType: 4
    displayName:
      uid: trait_4_name
      korean: "\uD559\uC790"
      english: Scholar
    description:
      uid: trait_4_description
      korean: "\uAE30\uC220 \uC0AC\uC5C5 \uC131\uACFC +2 \xB7 \uC9C4\uD589 \uC911
        \uC5F0\uAD6C\uB97C 1\uAC1C\uC6D4 \uB2E8\uCD95\uD558\uAC70\uB098 \uB9C8\uB098
        1 \uD68D\uB4DD"
      english: "Technology +2 \xB7 reduces active research by 1 month or gains 1
        mana"
    projectTypes: 01000000
    uniqueEffectValue: 1
  - traitType: 5
    displayName:
      uid: trait_5_name
      korean: "\uAD50\uC12D\uAC00"
      english: Negotiator
    description:
      uid: trait_5_description
      korean: "\uC778\uC7AC \uC0AC\uC5C5 \uC131\uACFC +2 \xB7 \uAD00\uB828 \uC0AC\uAC74\uC758
        \uC601\uC6C5 \uC120\uD0DD\uC9C0\uC640 \uC601\uD5A5\uB825 10 \uD68D\uB4DD"
      english: "Recruitment +2 \xB7 unlocks hero event choice and gains 10 influence"
    projectTypes: 04000000
    uniqueEffectValue: 10
  - traitType: 6
    displayName:
      uid: trait_6_name
      korean: "\uC758\uC0AC"
      english: Doctor
    description:
      uid: trait_6_description
      korean: "\uD68C\uBCF5 \uC0AC\uC5C5 \uC131\uACFC +2 \xB7 \uC8FC\uB454 \uC778\uBB3C\uC758
        \uBD80\uC0C1 1\uAC1C\uC6D4\uACFC \uD53C\uB85C 10 \uD68C\uBCF5"
      english: "Recovery +2 \xB7 heals 1 injury month and 10 fatigue for stationed
        characters"
    projectTypes: 06000000
    uniqueEffectValue: 1
  - traitType: 7
    displayName:
      uid: trait_7_name
      korean: "\uAD50\uAD00"
      english: Instructor
    description:
      uid: trait_7_description
      korean: "\uD6C8\uB828 \uC0AC\uC5C5 \uC131\uACFC +2 \xB7 \uC8FC\uB454 \uBD80\uB300\uC758
        \uC219\uB828 \uACBD\uD5D8 15 \uD68D\uB4DD"
      english: "Training +2 \xB7 grants 15 cohesion experience to stationed armies"
    projectTypes: 05000000
    uniqueEffectValue: 15
  relationshipEventDefinitions:
  - id: relationship_reconciliation
    title:
      uid: REL_RECON_TITLE
      korean: "\uAE68\uC9C4 \uC2E0\uB8B0"
      english: Broken Trust
    description:
      uid: REL_RECON_DESC
      korean: "\uAC08\uB4F1\uD558\uB358 \uB450 \uC778\uBB3C\uC774 \uAC19\uC740 \uC131\uC5D0\uC11C
        \uB2E4\uC2DC \uB9C8\uC8FC\uD588\uC2B5\uB2C8\uB2E4. \uAC70\uB9AC\uB97C \uB458\uC9C0
        \uC18D\uB0B4\uB97C \uD138\uC5B4\uB193\uC744\uC9C0 \uACB0\uC815\uD569\uB2C8\uB2E4."
      english: Two conflicted characters meet again in the same castle.
    requiredLevel: 0
    choices:
    - label:
        uid: REL_RECON_SAFE
        korean: "\uB2F9\uBD84\uAC04 \uAC70\uB9AC\uB97C \uB454\uB2E4"
        english: Keep some distance
      resultDescription:
        uid: REL_RECON_SAFE_RESULT
        korean: "\uAD00\uACC4\uAC00 \uBCF4\uD1B5\uC73C\uB85C \uD68C\uBCF5\uB418\uACE0
          \uACF5\uC801 +2"
        english: Relationship becomes normal and merit +2
      relationshipShift: 1
      meritDelta: 2
      fatigueDelta: 0
    - label:
        uid: REL_RECON_BOLD
        korean: "\uC194\uC9C1\uD558\uAC8C \uB300\uD654\uD55C\uB2E4"
        english: Speak honestly
      resultDescription:
        uid: REL_RECON_BOLD_RESULT
        korean: "\uAD00\uACC4\uAC00 \uCE5C\uC560\uB85C \uD68C\uBCF5\uB418\uACE0 \uACF5\uC801
          +5, \uD53C\uB85C +10"
        english: Relationship becomes fondness, merit +5, fatigue +10
      relationshipShift: 2
      meritDelta: 5
      fatigueDelta: 10
  - id: relationship_shared_oath
    title:
      uid: REL_OATH_TITLE
      korean: "\uD568\uAED8 \uC138\uC6B4 \uB9F9\uC138"
      english: A Shared Oath
    description:
      uid: REL_OATH_DESC
      korean: "\uC11C\uB85C\uB97C \uC2E0\uB8B0\uD558\uB294 \uB450 \uC778\uBB3C\uC774
        \uC55E\uC73C\uB85C\uC758 \uD611\uB825 \uBC29\uC2DD\uC744 \uC815\uD558\uB824
        \uD569\uB2C8\uB2E4."
      english: Two trusted characters decide how they will cooperate.
    requiredLevel: 2
    choices:
    - label:
        uid: REL_OATH_SAFE
        korean: "\uC11C\uB85C\uC758 \uC5ED\uD560\uC744 \uC874\uC911\uD55C\uB2E4"
        english: Respect each role
      resultDescription:
