      korean: "\uBC31\uC804\uC758 \uC5F0\uBB34\uC7A5"
      english: Veterans' Training Yard
    description:
      uid: legacy_training_description
      korean: "\uD6C8\uB828 \uC0AC\uC5C5 \uC131\uACFC\uB97C \uB192\uC774\uB294 \uC2E4\uC804
        \uAD50\uC721 \uC804\uD1B5\uC785\uB2C8\uB2E4."
