  - uid: UI_ACTIVITY_RECRUIT_TARGET
    korean: "{0} \xB7 \uC601\uC785\uD560 \uC778\uC7AC \uC120\uD0DD"
    english: "{0} \xB7 Choose Recruitment Target"
  - uid: UI_ACTIVITY_TARGET_HINT
