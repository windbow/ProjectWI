  - uid: UI_ADMIN_OPERATION_STATUS
    korean: "\uAE30\uBCF8 \uC6B4\uC601 \xB7 {0} \xB7 \uC6D4 {1}G"
    english: "Administration \xB7 {0} \xB7 {1}G/month"
  - uid: UI_ADMIN_OPERATION_PREVIEW
    korean: "\uC608\uC0C1 \uACC4\uD68D \xB7 {0} \xB7 {1} \xB7 \uC131\uACFC +{2} \xB7
