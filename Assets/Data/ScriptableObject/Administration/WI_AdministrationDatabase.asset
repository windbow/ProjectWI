    projectGainBonus: 2
  - id: legacy_recovery
    projectType: 6
    displayName:
      uid: legacy_recovery_name
      korean: "\uCE58\uC720\uC758 \uC815\uC6D0"
      english: Garden of Recovery
    description:
      uid: legacy_recovery_description
      korean: "\uD68C\uBCF5 \uC0AC\uC5C5 \uC131\uACFC\uB97C \uB192\uC774\uB294 \uCE58\uB8CC\uC640
        \uD734\uC2DD\uC758 \uC7A5\uC18C\uC785\uB2C8\uB2E4."
