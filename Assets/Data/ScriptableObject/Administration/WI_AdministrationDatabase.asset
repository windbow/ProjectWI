      korean: "\uAE08\uD654 \uC218\uC785\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
      english: Increases gold income.
    manaCost: 100
    requiredTechnology: 35
    durationMonths: 2
    effectType: 0
    effectValue: 10
    prerequisiteResearchId: 
  - id: arcane_administration
    displayName:
      uid: RESEARCH_ARCANE_ADMIN
      korean: "\uB9C8\uB3C4 \uD589\uC815\uD559"
      english: Arcane Administration
    description:
      uid: RESEARCH_ARCANE_ADMIN_DESC
      korean: "\uBAA8\uB4E0 \uC911\uC810 \uC0AC\uC5C5 \uC131\uACFC\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
      english: Improves all focus projects.
    manaCost: 140
    requiredTechnology: 45
    durationMonths: 2
    effectType: 3
    effectValue: 2
    prerequisiteResearchId: mana_circulation
  - id: battle_enchantment
    displayName:
      uid: RESEARCH_BATTLE_ENCHANT
      korean: "\uC804\uD22C \uB9C8\uBC95 \uBD80\uC5EC"
      english: Battle Enchantment
    description:
      uid: RESEARCH_BATTLE_ENCHANT_DESC
      korean: "\uBAA8\uB4E0 \uBD80\uB300\uC758 \uC804\uD22C\uB825\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
      english: Increases battle power of every army.
    manaCost: 180
    requiredTechnology: 55
    durationMonths: 3
    effectType: 4
    effectValue: 15
    prerequisiteResearchId: arcane_administration
  - id: diplomatic_seals
    displayName:
      uid: RESEARCH_DIPLOMATIC_SEALS
      korean: "\uB9C8\uB3C4 \uC778\uC7A5 \uC678\uAD50"
      english: Arcane Seals
    description:
      uid: RESEARCH_DIPLOMATIC_SEALS_DESC
      korean: "\uAC01 \uC131\uC758 \uC601\uD5A5\uB825 \uC218\uC785\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
      english: Increases influence income in every castle.
    manaCost: 120
    requiredTechnology: 40
    durationMonths: 2
    effectType: 2
    effectValue: 1
    prerequisiteResearchId: mana_circulation
  titleDefinitions:
  - id: retainer
    displayName:
      uid: TITLE_RETAINER
