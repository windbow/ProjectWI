      uid: legacy_recruitment_name
      korean: "\uB9F9\uC138\uC758 \uD68C\uB791"
      english: Hall of Oaths
    description:
      uid: legacy_recruitment_description
      korean: "\uC778\uC7AC \uC0AC\uC5C5 \uC131\uACFC\uB97C \uB192\uC774\uB294 \uC2E0\uB8B0\uC640
        \uBA85\uC131\uC758 \uC7A5\uC18C\uC785\uB2C8\uB2E4."
      english: A place of trust and renown that improves recruitment projects.
    projectGainBonus: 2
  - id: legacy_training
    projectType: 5
    displayName:
