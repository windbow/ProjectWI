      korean: "\uAC1C\uCC99\uC790\uC758 \uAD11\uC7A5"
      english: Founders' Plaza
    description:
      uid: legacy_expansion_description
      korean: "\uD655\uC7A5 \uC0AC\uC5C5 \uC131\uACFC\uB97C \uB192\uC774\uB294 \uAC1C\uCC99
        \uC815\uC2E0\uC758 \uC0C1\uC9D5\uC785\uB2C8\uB2E4."
      english: A symbol of pioneering spirit that improves expansion projects.
    projectGainBonus: 2
  recruitmentEventDefinitions:
  - id: recruit_trust
    title:
      uid: RECRUIT_TRUST_TITLE
      korean: "\uC2E0\uB8B0\uC758 \uC99D\uBA85"
      english: Proof of Trust
    description:
      uid: RECRUIT_TRUST_DESC
      korean: "\uD6C4\uBCF4\uB294 \uB9D0\uBFD0\uC778 \uC57D\uC18D\uC774 \uC544\uB2C8\uB77C
        \uBBFF\uC744 \uC218 \uC788\uB294 \uD0DC\uB3C4\uB97C \uC694\uAD6C\uD569\uB2C8\uB2E4."
      english: The candidate asks for a trustworthy commitment.
    choices:
    - label:
        uid: RECRUIT_TRUST_SAFE_label
        korean: "\uC694\uAD6C\uB97C \uCC28\uBD84\uD788 \uBC1B\uC544\uB4E4\uC778\uB2E4"
        english: "\uC694\uAD6C\uB97C \uCC28\uBD84\uD788 \uBC1B\uC544\uB4E4\uC778\uB2E4"
      resultDescription:
        uid: RECRUIT_TRUST_SAFE_result
        korean: "\uB4F1\uC6A9, \uACF5\uC801 +5, \uD53C\uB85C +5"
        english: "\uB4F1\uC6A9, \uACF5\uC801 +5, \uD53C\uB85C +5"
      requiredReputation: 0
      requiredMerit: 0
      requiredFactionCastleCount: 0
