:root { --gold:#b68a3d; --gold-light:#e2c77e; --ink:#17130f; --paper:#d5c39b; --navy:#111a20; --red:#76231e; }
.app { flex-grow:1; color:#eee3ca; background-color:#090908; }
.administration-template { min-width:0; min-height:0; }
.administration-hud-template { flex-shrink:0; }
.administration-view-template { flex-grow:1; }
.administration-overlay-template { position:absolute; left:0; right:0; top:0; bottom:0; }
.ornament-background { position:absolute; left:0; right:0; top:0; bottom:0; background-color:#15110d; opacity:.9; }
.frame-gold { border-width:2px; border-color:#62471f; border-top-color:var(--gold-light); }
.frame-dark { background-color:rgba(14,13,11,.92); border-width:1px; border-color:#6d5734; }
.image-placeholder { background-color:#47514b; border-width:1px; border-color:#8b774e; color:#c1b89f; -unity-text-align:middle-center; }
.placeholder-copy { align-self:center; margin-top:40%; padding:10px 18px; background-color:rgba(0,0,0,.55); color:#cfc6ad; }
.placeholder-copy.large { font-size:20px; }
.compact-hud { height:54px; flex-direction:row; align-items:center; padding:5px 18px; background-color:rgba(218,210,185,.94); color:#2a251d; }
.date-label { min-width:150px; font-size:15px; -unity-font-style:bold; }
.faction-emblem { width:36px; height:36px; margin-left:10px; -unity-background-scale-mode:scale-to-fit; }
.faction-label { min-width:130px; padding-left:14px; border-left-width:1px; border-left-color:#8c7953; font-size:16px; -unity-font-style:bold; }
.resource-chip { min-width:145px; height:38px; margin-left:8px; padding:5px 10px; background-color:rgba(49,45,37,.12); border-bottom-width:2px; -unity-text-align:middle-center; font-size:12px; }
.resource-chip.gold { border-bottom-color:#a77a21; }.resource-chip.mana { border-bottom-color:#4679a1; }.resource-chip.influence { border-bottom-color:#725c99; }
.hud-spacer,.command-spacer { flex-grow:1; }.hud-icon-button { width:58px; height:32px; margin-left:5px; background-color:#34352e; color:#eee1bd; border-color:#80652f; }
.screen-view { position:absolute; left:0; right:0; top:54px; bottom:0; }
.global-view { display:flex; padding:10px 5% 8px; }
.map-frame { position:relative; flex-grow:1; overflow:hidden; background-color:#313833; }
.map-background-placeholder { position:absolute; left:0; right:0; top:0; bottom:0; background-color:#4d554c; -unity-background-scale-mode:scale-and-crop; }
.map-heading { position:absolute; left:24px; right:24px; top:14px; height:55px; flex-direction:row; align-items:center; background-color:rgba(226,220,199,.88); padding:8px 18px; color:#25221c; }
.screen-title { font-size:24px; -unity-font-style:bold; margin-right:30px; }.screen-subtitle { font-size:13px; }
.objective-strip { position:absolute; left:285px; top:76px; min-width:420px; height:34px; background-color:rgba(31,27,20,.92); color:#e7cf82; border-width:1px; border-color:#9b7a2f; -unity-text-align:middle-left; padding-left:14px; font-size:13px; }
.map { position:absolute; left:8%; right:8%; top:80px; bottom:120px; }
.castle-node { position:absolute; width:64px; min-height:34px; margin-left:-32px; margin-top:-17px; padding:3px; border-width:2px; border-color:#e0c883; border-radius:5px; color:white; font-size:8px; -unity-font-style:bold; -unity-text-align:middle-center; }
.faction-legend { position:absolute; left:24px; top:90px; width:250px; padding:12px; }.legend-title { color:#e5ca83; -unity-font-style:bold; margin-bottom:6px; }.legend-copy { white-space:normal; line-height:19px; font-size:11px; }
.map-tools { position:absolute; right:20px; bottom:94px; height:40px; flex-direction:row; align-items:center; padding:4px 8px; background-color:rgba(16,15,12,.9); border-radius:18px; }.map-tool-button { width:32px; height:30px; margin-left:4px; background-color:#302b22; color:#e6cf96; border-width:0; }.zoom-label { margin:0 8px; font-size:11px; }
.global-command-bar { height:68px; margin-top:8px; flex-direction:row; align-items:center; padding:8px 14px; background-color:rgba(35,29,22,.97); }
.global-command { width:92px; height:44px; margin-right:7px; background-color:#27231d; color:#ddcda8; border-color:#6b522b; font-size:14px; }.global-command:hover { background-color:#493923; }
.global-command.important { border-color:#c09543; color:#f1d58e; }
.turn-button { width:150px; height:48px; background-color:var(--red); color:#f0ddaf; border-width:2px; border-color:#bb8a3d; font-size:18px; -unity-font-style:bold; }
.strategy-guide { height:72px; margin-top:6px; flex-direction:row; align-items:center; padding:5px 14px; }.guide-portrait { width:58px; height:58px; margin-right:14px; }.guide-copy { flex-grow:1; }.guide-title { color:#e5cf99; -unity-font-style:bold; font-size:14px; }.guide-description { color:#b9ad94; margin-top:4px; font-size:11px; }
.castle-view { display:none; background-color:#252d30; }
.castle-background-placeholder { position:absolute; left:0; right:0; top:0; bottom:0; background-color:#55615f; -unity-background-scale-mode:scale-and-crop; }
.castle-top-strip { position:absolute; left:24px; right:24px; top:18px; height:82px; flex-direction:row; align-items:center; padding:12px 20px; }.back-button { width:148px; height:44px; margin-right:22px; background-color:#322d24; color:#e7d5a8; border-color:#8b6b31; font-size:14px; }.castle-heading-copy { flex-grow:1; }.castle-title { color:#f0dca5; font-size:28px; -unity-font-style:bold; }.castle-info { color:#beb39c; font-size:13px; margin-top:4px; }
.governor-full { position:absolute; left:2.5%; bottom:18px; width:23%; height:68%; background-color:rgba(25,28,28,.94); border-width:2px; border-color:#8b774e; font-size:18px; -unity-background-scale-mode:scale-and-crop; }
.castle-stat-panel { position:absolute; left:28%; top:118px; width:390px; flex-direction:row; flex-wrap:wrap; padding:10px; }.castle-stat { width:48%; height:44px; margin:1%; padding:11px; background-color:rgba(224,211,178,.94); color:#2d2518; -unity-text-align:middle-center; -unity-font-style:bold; font-size:13px; }
.castle-command-menu { position:absolute; right:3%; top:118px; width:220px; padding:14px; background-color:rgba(39,29,21,.96); }.command-title { color:#efcf82; font-size:19px; -unity-font-style:bold; -unity-text-align:middle-center; margin-bottom:12px; }.castle-command { height:46px; margin-bottom:7px; background-color:#713027; color:#f1dfb7; border-color:#b47e35; font-size:13px; }.castle-command:hover { background-color:#8b3d31; }.castle-command.danger { background-color:#4d1e1a; }
.castle-bottom-info { position:absolute; left:28%; right:20%; bottom:18px; height:285px; padding:14px 18px; }.section-label { color:#e4c982; font-size:13px; -unity-font-style:bold; margin-bottom:6px; }.project-status { min-height:38px; padding:9px 12px; background-color:rgba(218,203,167,.94); color:#30261a; font-size:12px; }.slot-columns { flex-direction:row; margin-top:10px; }.slot-column { width:50%; padding-right:12px; }.slot-grid { flex-direction:row; flex-wrap:wrap; align-content:flex-start; }.slot { width:48%; height:76px; margin-right:2%; margin-bottom:6px; padding:5px; flex-direction:row; align-items:center; background-color:rgba(216,198,157,.95); border-width:1px; border-color:#846938; color:#302417; }.slot-image { width:58px; height:64px; flex-shrink:0; margin-right:7px; background-color:#242723; border-width:1px; border-color:#9b7c42; }.hero-slot-image { -unity-background-scale-mode:scale-and-crop; }.facility-slot-image { -unity-background-scale-mode:scale-to-fit; }.slot-caption { flex-grow:1; white-space:normal; font-size:11px; -unity-text-align:middle-center; -unity-font-style:bold; }.empty-slot { justify-content:center; opacity:.72; }
.modal-layer { display:none; position:absolute; left:0; right:0; top:0; bottom:0; align-items:center; justify-content:center; background-color:rgba(0,0,0,.76); }.modal-panel { width:560px; max-height:88%; padding:24px; background-color:#d7c49b; border-width:3px; border-color:#69471d; color:#332515; overflow:hidden; }.modal-header { flex-direction:row; align-items:flex-start; flex-shrink:0; }.modal-title { flex-grow:1; flex-shrink:1; font-size:23px; -unity-font-style:bold; margin-right:14px; margin-bottom:14px; }.modal-panel Button { min-height:42px; margin-top:6px; background-color:#3d2b1d; color:#ead5a9; }.modal-close { flex-shrink:0; width:120px; margin-top:0; }.modal-scroll-view { flex-grow:1; flex-shrink:1; min-height:0; }.modal-scroll-content { flex-shrink:0; padding-right:8px; padding-bottom:4px; }.portrait-placeholder { height:180px; margin-bottom:12px; }.research-row { min-height:48px; margin-top:5px; padding:7px; flex-direction:row; align-items:center; justify-content:space-between; background-color:#eadbb9; }
.modal-fixed-footer { flex-shrink:0; max-height:210px; margin-top:12px; padding:12px; background-color:#c9cbcd; border-width:2px; border-color:#555c62; overflow:hidden; }
.modal-fixed-footer .modal-section-heading { margin-top:0; }
.modal-fixed-footer Button { flex-shrink:0; }
.modal-panel Label,.modal-panel Button { white-space:normal; max-width:100%; }
.modal-section-heading { flex-shrink:0; margin-top:12px; margin-bottom:3px; -unity-font-style:bold; }
.objective-modal-copy { white-space:normal; flex-shrink:0; margin-bottom:10px; line-height:22px; }
.objective-modal-progress { white-space:normal; flex-shrink:0; margin-top:2px; margin-bottom:8px; -unity-font-style:bold; }
.campaign-start-layer { position:absolute; left:0; right:0; top:0; bottom:0; align-items:center; justify-content:center; background-color:#11100d; }
.campaign-start-backdrop { position:absolute; left:0; right:0; top:0; bottom:0; background-color:#182329; opacity:.72; }
.campaign-start-panel { width:900px; padding:38px 46px 32px; background-color:rgba(20,18,14,.97); color:#e8d8b2; }
.campaign-kicker { color:#b8934d; font-size:14px; letter-spacing:5px; -unity-text-align:middle-center; }
.campaign-title { margin-top:8px; color:#f0d492; font-size:38px; -unity-font-style:bold; -unity-text-align:middle-center; }
.campaign-description { margin:12px 30px 24px; color:#c8bda4; font-size:15px; white-space:normal; -unity-text-align:middle-center; }
.difficulty-heading { margin-bottom:10px; color:#e7ce94; font-size:18px; -unity-font-style:bold; }
.difficulty-options { flex-direction:row; justify-content:space-between; }
.difficulty-card { width:31.8%; min-height:154px; padding:18px; background-color:#28251f; border-width:2px; border-color:#5f5137; color:#d8c9a8; white-space:normal; -unity-text-align:upper-left; }
.difficulty-card:hover { background-color:#393126; border-color:#ad8742; }
.difficulty-card.selected { background-color:#493722; border-color:#e1b75e; color:#f3dda8; }
.variant-heading { margin-top:14px; margin-bottom:8px; color:#e7ce94; font-size:16px; -unity-font-style:bold; }
.variant-options { flex-direction:row; justify-content:space-between; }
.variant-card { width:31.8%; min-height:88px; padding:12px; background-color:#24221d; border-width:1px; border-color:#5f5137; color:#cfc09f; white-space:normal; -unity-text-align:upper-left; }
.variant-card:hover { background-color:#353026; border-color:#ad8742; }
.variant-card.selected { background-color:#493722; border-width:2px; border-color:#e1b75e; color:#f3dda8; }
.campaign-start-button { height:54px; margin-top:22px; background-color:#7a2a22; border-width:2px; border-color:#c39543; color:#f2ddb0; font-size:18px; -unity-font-style:bold; }
.campaign-continue-button { height:42px; margin-top:8px; background-color:#302c24; border-color:#806839; color:#d9c79f; }
.difficulty-note { margin-top:12px; color:#968d7c; font-size:11px; -unity-text-align:middle-center; }

/* 흑백 전략 UI 테마: 지도와 세력색은 유지하고 조작·정보 계층을 무채색으로 통일합니다. */
:root { --gold:#d9dde1; --gold-light:#f4f5f6; --ink:#08090a; --paper:#e6e7e8; --navy:#111417; --red:#7b2725; }
.app { color:#f1f2f3; background-color:#07090b; }
.ornament-background { background-color:#080a0c; opacity:.94; }
.frame-gold { border-color:#5c6268; border-top-color:#edf0f2; }
.frame-dark { background-color:rgba(5,7,9,.92); border-color:#636a70; }
.image-placeholder { background-color:#34383c; border-color:#8a9095; color:#d7dadd; }
.compact-hud { background-color:rgba(239,240,241,.95); color:#101214; }
.faction-label { border-left-color:#858b90; }
.resource-chip { background-color:rgba(16,18,20,.09); }
.resource-chip.gold,.resource-chip.mana,.resource-chip.influence { border-bottom-color:#4d555c; }
.hud-icon-button { background-color:#111315; color:#f4f5f6; border-color:#777d82; }
.map-heading { background-color:rgba(244,245,246,.92); color:#111315; }
.objective-strip { background-color:rgba(3,4,5,.91); color:#f0f2f3; border-color:#858b90; }
.faction-legend { background-color:rgba(3,4,5,.9); }.legend-title { color:#ffffff; }
.map-tools { background-color:rgba(3,4,5,.92); }.map-tool-button { background-color:#202326; color:#f2f3f4; }
.global-command-bar { background-color:rgba(5,6,7,.97); }
.global-command { background-color:#17191b; color:#f0f1f2; border-color:#666d73; }.global-command:hover { background-color:#34383c; }
.global-command.important { border-color:#f0f2f3; color:#ffffff; }
.turn-button { background-color:#16191b; color:#ffffff; border-color:#f0f2f3; }
.guide-title,.section-label { color:#ffffff; }.guide-description { color:#bdc2c6; }
.castle-top-strip { background-color:rgba(4,6,8,.86); }.back-button { background-color:#17191b; color:#f4f5f6; border-color:#737a80; }
.castle-title { color:#ffffff; }.castle-info { color:#c4c8cb; }
.governor-full { background-color:rgba(8,10,12,.92); border-color:#8b9297; }
.castle-stat { background-color:rgba(238,239,240,.94); color:#111315; }
.castle-command-menu { background-color:rgba(4,5,6,.95); border-color:#757c81; }.command-title { color:#ffffff; }
.castle-command { background-color:#202326; color:#ffffff; border-color:#747b81; }.castle-command:hover { background-color:#3a3f43; }.castle-command.danger { background-color:#572321; }
.project-status,.slot { background-color:rgba(235,236,237,.95); color:#151719; border-color:#878d92; }
.slot-image { background-color:#202326; border-color:#858b90; }
.modal-panel { background-color:#e8e9ea; border-color:#555c62; color:#111315; }.modal-panel Button { background-color:#17191b; color:#f5f6f7; border-color:#70777d; }.research-row { background-color:#f3f4f5; }
.campaign-start-layer { background-color:#090b0d; }.campaign-start-backdrop { background-color:#101820; opacity:.78; }
.campaign-start-panel { background-color:rgba(5,6,7,.97); color:#f0f1f2; }.campaign-kicker,.campaign-title,.difficulty-heading,.variant-heading { color:#ffffff; }
.campaign-description { color:#c8ccd0; }
.difficulty-card,.variant-card { background-color:#202326; border-color:#62696f; color:#d7dadd; }
.difficulty-card:hover,.variant-card:hover { background-color:#34383c; border-color:#dfe2e4; }
.difficulty-card.selected,.variant-card.selected { background-color:#f0f1f2; border-color:#ffffff; color:#111315; }
.campaign-start-button { background-color:#f0f1f2; border-color:#ffffff; color:#111315; }
.campaign-continue-button { background-color:#17191b; border-color:#737a80; color:#e4e6e8; }.difficulty-note { color:#9fa5aa; }
.faction-label,.castle-title,.castle-info,.slot-caption { overflow:hidden; text-overflow:ellipsis; }
.faction-label,.castle-title { white-space:nowrap; }

/* 조작 상태 규칙: 호버는 백색 반전, 선택은 지속 백색, 비활성은 저명도, 위험은 적갈색으로 고정합니다. */
.hud-icon-button:hover,.map-tool-button:hover,.global-command:hover,.turn-button:hover,.back-button:hover,.castle-command:hover,.modal-panel Button:hover,.campaign-start-button:hover,.campaign-continue-button:hover {
    background-color:#f1f2f3; color:#111315; border-color:#ffffff;
}
.hud-icon-button:active,.map-tool-button:active,.global-command:active,.turn-button:active,.back-button:active,.castle-command:active,.modal-panel Button:active,.campaign-start-button:active,.campaign-continue-button:active {
    background-color:#bfc4c8; color:#080a0c; border-color:#e5e7e9;
}
.hud-icon-button:disabled,.map-tool-button:disabled,.global-command:disabled,.turn-button:disabled,.back-button:disabled,.castle-command:disabled,.modal-panel Button:disabled,.campaign-start-button:disabled,.campaign-continue-button:disabled,.objective-strip:disabled {
    background-color:#202326; color:#777d82; border-color:#464c51; opacity:.48;
}
.selected,.active-command,.qa-selected-state,.modal-panel Button.selected,.modal-panel Button.qa-selected-state { background-color:#f1f2f3; color:#111315; border-color:#ffffff; }
.danger,.retreat,.qa-danger-state,.modal-panel Button.danger,.modal-panel Button.qa-danger-state { background-color:#572321; color:#ffffff; border-color:#a75a56; }
.danger:hover,.retreat:hover,.qa-danger-state:hover { background-color:#8a302d; color:#ffffff; border-color:#e09a95; }
.qa-state-row { min-height:56px; margin-top:8px; flex-direction:row; align-items:center; }
.qa-state-label { width:110px; color:#23272a; -unity-font-style:bold; }
.qa-state-button { width:280px; min-height:44px; }
.qa-hover-state,.modal-panel Button.qa-hover-state { background-color:#f1f2f3; color:#111315; border-color:#ffffff; }
.qa-disabled-state { background-color:#202326; color:#777d82; border-color:#464c51; opacity:.48; }
.qa-state-note { margin-top:10px; color:#3e4347; white-space:normal; }
.calculation-sample { margin-top:8px; padding:10px 12px; background-color:#f4f5f6; border-left-width:3px; border-left-color:#555c62; }
.calculation-title { color:#111315; -unity-font-style:bold; margin-bottom:3px; }
.calculation-detail { color:#3e4347; white-space:normal; }
@media (max-width:1365px) { .global-view { padding-left:2%; padding-right:2%; }.resource-chip { min-width:90px; font-size:10px; }.governor-full { width:24%; }.castle-stat-panel { left:27%; width:330px; }.castle-bottom-info { left:27%; right:21%; height:250px; }.castle-command-menu { right:2%; width:190px; }.slot { height:66px; }.slot-image { width:48px; height:54px; }.slot-caption { font-size:10px; } }
@media (max-width:1000px) { .governor-full { width:27%; }.castle-bottom-info { left:31%; right:25%; }.castle-command-menu { width:175px; }.castle-stat-panel { left:31%; width:300px; } }

/* 전략 지휘실 V2: UI 콘셉트 시안의 청회색 프레임과 명확한 카드 계층을 실제 화면에 적용합니다. */
:root { --wi-bg:#060b10; --wi-panel:#0d151d; --wi-panel-raised:#131e28; --wi-line:#52616e; --wi-line-bright:#9aa8b3; --wi-text:#f2f5f7; --wi-muted:#aab4bc; --wi-blue:#244d73; --wi-blue-bright:#3c719e; --wi-danger:#7a2d2b; }
.app { background-color:var(--wi-bg); color:var(--wi-text); }
.ornament-background { background-color:#05090d; opacity:.97; }
.frame-gold { border-width:1px; border-color:var(--wi-line); border-top-width:2px; border-top-color:var(--wi-line-bright); }
.frame-dark { background-color:rgba(8,14,20,.94); border-width:1px; border-color:var(--wi-line); }
.compact-hud { height:64px; padding:7px 22px; background-color:rgba(7,12,18,.98); color:var(--wi-text); border-bottom-width:2px; border-bottom-color:#354653; }
.screen-view { top:64px; }
.date-label { min-width:155px; color:#dce4e9; font-size:15px; }
.faction-emblem { width:42px; height:42px; }
.faction-label { min-width:160px; color:#ffffff; border-left-color:#44535f; font-size:18px; }
.resource-chip { min-width:150px; height:44px; margin-left:5px; padding:6px 12px; background-color:#111a22; color:#e5ebef; border-width:0; border-bottom-width:2px; border-bottom-color:#52616e; font-size:12px; }
.resource-chip.gold { border-bottom-color:#9c8149; }.resource-chip.mana { border-bottom-color:#47799d; }.resource-chip.influence { border-bottom-color:#808a94; }
.hud-icon-button { min-width:62px; height:36px; background-color:#111a22; color:#dce3e8; border-width:1px; border-color:#485762; }
.global-view { padding:12px 18px 10px; }
.map-frame { background-color:#151f25; border-color:#53636f; }
.map-heading { left:18px; right:auto; top:16px; width:520px; height:58px; padding:9px 18px; background-color:rgba(7,12,17,.92); color:#ffffff; border-left-width:3px; border-left-color:#e7edf1; }
.screen-title { font-size:22px; }.screen-subtitle { color:var(--wi-muted); }
.objective-strip { left:auto; right:20px; top:18px; width:430px; height:48px; padding-left:16px; background-color:rgba(9,15,21,.94); color:#e8edf1; border-color:#586874; }
.faction-legend { left:18px; top:88px; width:230px; padding:14px; background-color:rgba(6,11,16,.93); border-color:#52616d; }
.legend-title { color:#ffffff; font-size:14px; }.legend-copy { color:#b8c2c9; }
.castle-node { border-width:2px; border-color:#e8edf0; border-radius:2px; background-color:#17232c; }
.map-tools { right:18px; bottom:18px; height:42px; background-color:rgba(7,12,17,.94); border-width:1px; border-color:#485761; border-radius:2px; }
.map-tool-button { background-color:#16212a; color:#edf2f4; border-width:1px; border-color:#46545f; }
.global-command-bar { height:76px; margin-top:8px; padding:9px 12px; background-color:#080e14; border-color:#4a5a66; }
.global-command { width:105px; height:52px; margin-right:6px; background-color:#111a22; color:#e7edf0; border-width:1px; border-color:#52616d; font-size:15px; }
.global-command.important { background-color:#162330; border-color:#80909c; color:#ffffff; }
.turn-button { width:190px; height:56px; background-color:#183451; color:#ffffff; border-width:2px; border-color:#7894aa; font-size:20px; }
.strategy-guide { height:64px; background-color:#091017; border-color:#3f4e59; }
.guide-portrait { width:50px; height:50px; background-color:#111b23; border-color:#52616e; }
.guide-title { color:#edf2f4; }.guide-description { color:#99a6af; }
.castle-top-strip { left:20px; right:20px; top:16px; height:88px; padding:12px 18px; background-color:rgba(6,11,16,.94); border-color:#53636f; }
.back-button { width:160px; height:48px; background-color:#111a22; color:#eff3f5; border-color:#596975; }
.castle-title { color:#ffffff; }.castle-info { color:#abb6be; }
.governor-full { background-color:rgba(7,12,17,.95); border-color:#5b6a75; }
.castle-stat-panel { background-color:rgba(7,12,17,.94); border-color:#53636f; }
.castle-stat { background-color:#eef1f3; color:#10161b; border-left-width:3px; border-left-color:#506a80; }
.castle-command-menu { padding:14px; background-color:rgba(7,12,17,.97); border-color:#5b6b76; }
.command-title { color:#ffffff; border-bottom-width:1px; border-bottom-color:#3f4c56; padding-bottom:10px; }
.castle-command { height:46px; background-color:#131f28; color:#edf2f4; border-width:1px; border-color:#52616d; }
.castle-command.danger { background-color:#542524; border-color:#9e5652; }
.castle-bottom-info { background-color:rgba(7,12,17,.95); border-color:#53636f; }
.section-label { color:#eef3f5; }
.project-status { background-color:#e9edf0; color:#11171c; border-left-width:3px; border-left-color:#55728a; }
.slot { background-color:#e8ecef; color:#10161b; border-color:#71808b; }
.slot-image { background-color:#111a22; border-color:#697985; }

/* 성 수치마다 의미가 바로 보이도록 전용 문장 카드를 배경으로 사용합니다. */
.castle-stat { padding-left:54px; background-color:transparent; border-left-width:0; -unity-background-scale-mode:stretch-to-fill; -unity-slice-left:18; -unity-slice-right:18; -unity-slice-top:18; -unity-slice-bottom:18; }
.castle-stat-prosperity { background-image:url("project://database/Assets/Resources/UI/Generated/castle_stat_prosperity.png"); }
.castle-stat-technology { background-image:url("project://database/Assets/Resources/UI/Generated/castle_stat_technology.png"); }
.castle-stat-stability { background-image:url("project://database/Assets/Resources/UI/Generated/castle_stat_stability.png"); }
.castle-stat-defense { background-image:url("project://database/Assets/Resources/UI/Generated/castle_stat_defense.png"); }

/* 주둔 영웅과 특화 시설은 서로 다른 문장 프레임으로 구분합니다. */
.hero-slot, .facility-slot { padding:6px 8px; background-color:transparent; border-width:0; -unity-background-scale-mode:stretch-to-fill; -unity-slice-left:74; -unity-slice-right:34; -unity-slice-top:30; -unity-slice-bottom:30; }
.hero-slot { background-image:url("project://database/Assets/Resources/UI/Generated/hero_slot_card.png"); }
.facility-slot { background-image:url("project://database/Assets/Resources/UI/Generated/facility_slot_card.png"); }
.hero-slot .slot-caption, .facility-slot .slot-caption { color:#111820; -unity-text-outline-width:0; }
.hero-slot.empty-slot, .facility-slot.empty-slot { opacity:.82; }

/* 영웅과 특화 시설을 독립 패널로 분리하고 각 목록의 넘침을 내부 스크롤로 처리합니다. */
.slot-columns { flex-grow:1; min-height:0; overflow:hidden; justify-content:space-between; }
.castle-slot-section { width:49%; height:100%; min-height:0; padding:8px 9px; background-color:rgba(3,8,12,.78); border-width:1px; border-color:#53636f; }
.hero-slot-section { margin-right:1%; }
.facility-slot-section { margin-left:1%; padding-right:9px; }
.slot-section-title { flex-shrink:0; padding-bottom:5px; margin-bottom:6px; border-bottom-width:1px; border-bottom-color:#667681; }
.slot-scroll { flex-grow:1; min-height:0; overflow:hidden; }
.slot-scroll .unity-scroll-view__content-container { flex-direction:row; flex-wrap:wrap; align-content:flex-start; padding-right:5px; }
.slot-scroll .unity-scroll-view__vertical-scroller { width:10px; margin-left:3px; }
.slot-scroll .unity-scroller__slider { background-color:#263746; }
.slot-scroll .unity-base-slider__dragger { background-color:#9ba8b1; }
.hero-slot-grid, .facility-slot-grid { width:100%; flex-direction:row; flex-wrap:wrap; align-content:flex-start; }
.facility-slot-grid .slot { width:100%; margin-right:0; }
.modal-layer { background-color:rgba(1,4,7,.82); }
.modal-panel { width:620px; max-height:90%; padding:0; background-color:#0c141b; color:#edf2f4; border-width:1px; border-color:#71808b; }
.modal-header { min-height:64px; padding:14px 16px; align-items:center; background-color:#e9edf0; border-bottom-width:2px; border-bottom-color:#566672; }
.modal-title { margin:0 14px 0 0; color:#10161b; font-size:23px; }
.modal-close { width:110px; height:38px; margin:0; background-color:#111a22; color:#ffffff; border-color:#52616d; }
.modal-scroll-view { margin:0; background-color:#0c141b; }
.modal-scroll-content { padding:16px 18px 18px; }
.modal-panel Label { color:#dfe5e9; }
.modal-panel Button { min-height:46px; margin-top:8px; padding:8px 12px; background-color:#15212a; color:#edf2f4; border-width:1px; border-color:#5b6a75; }
.modal-panel .modal-section-heading { color:#ffffff; padding-bottom:6px; border-bottom-width:1px; border-bottom-color:#3f4d57; }
.research-row,.calculation-sample { background-color:#16212a; border-color:#52616d; }
.calculation-title { color:#ffffff; }.calculation-detail,.qa-state-note { color:#b5c0c7; }
.modal-fixed-footer { max-height:225px; margin:0; padding:12px 18px 16px; background-color:#111c25; border-width:0; border-top-width:2px; border-top-color:#5b6c78; }
.modal-fixed-footer Button.danger { background-color:#6d2b29; border-color:#b46660; }
.campaign-start-panel { background-color:rgba(7,12,17,.98); border-color:#667681; }
.campaign-kicker { color:#8fa5b5; }.campaign-title { color:#ffffff; }.campaign-description { color:#b5c0c7; }
.difficulty-card,.variant-card { background-color:#111b23; border-color:#52616d; color:#dce3e7; }
.difficulty-card.selected,.variant-card.selected { background-color:#e9edf0; color:#10161b; border-color:#ffffff; }
.campaign-start-button { background-color:#1d4262; border-color:#7b9ab1; color:#ffffff; }
.campaign-continue-button { background-color:#121d26; border-color:#586873; color:#dce4e9; }

.hud-icon-button:hover,.map-tool-button:hover,.global-command:hover,.turn-button:hover,.back-button:hover,.castle-command:hover,.modal-panel Button:hover,.campaign-start-button:hover,.campaign-continue-button:hover { background-color:#e9edf0; color:#10161b; border-color:#ffffff; }
.selected,.active-command,.qa-selected-state,.modal-panel Button.selected,.modal-panel Button.qa-selected-state { background-color:#dfe6eb; color:#10161b; border-color:#ffffff; }
.danger,.retreat,.qa-danger-state,.modal-panel Button.danger,.modal-panel Button.qa-danger-state { background-color:var(--wi-danger); color:#ffffff; border-color:#b76c67; }
.generated-texture-button { flex-direction:row; align-items:center; justify-content:center; -unity-background-scale-mode:stretch-to-fill; -unity-background-image-tint-color:#ffffff; }
.generated-texture-button:hover { -unity-background-image-tint-color:#d9e4ec; }
.generated-texture-button:active { -unity-background-image-tint-color:#aebbc5; }
.generated-texture-button:disabled { -unity-background-image-tint-color:#66727b; }
.generated-command-icon { width:30px; height:30px; flex-shrink:0; margin-right:7px; -unity-background-scale-mode:scale-to-fit; }
.turn-button .generated-command-icon { width:36px; height:36px; margin-right:10px; }
.generated-panel-background { -unity-background-scale-mode:stretch-to-fill; -unity-background-image-tint-color:#ffffff; }

@media (max-width:1365px) { .compact-hud { padding-left:10px; padding-right:10px; }.date-label { min-width:125px; }.faction-label { min-width:120px; }.resource-chip { min-width:105px; }.global-command { width:82px; }.turn-button { width:155px; }.objective-strip { width:360px; }.modal-panel { width:580px; } }

/* 생성 UI 이미지는 UXML/USS에서 직접 참조해 UI Builder와 런타임에서 같은 모습으로 표시합니다. */
.generated-normal { background-image:url("project://database/Assets/Resources/UI/Generated/button_normal.png"); -unity-background-scale-mode:stretch-to-fill; }
.generated-primary { background-image:url("project://database/Assets/Resources/UI/Generated/button_primary.png"); -unity-background-scale-mode:stretch-to-fill; }
.generated-danger { background-image:url("project://database/Assets/Resources/UI/Generated/button_danger.png"); -unity-background-scale-mode:stretch-to-fill; }
.generated-panel-background { background-image:url("project://database/Assets/Resources/UI/Generated/popup_panel.png"); -unity-background-scale-mode:stretch-to-fill; }
.icon-military { background-image:url("project://database/Assets/Resources/UI/Generated/icon_military.png"); }
.icon-heroes { background-image:url("project://database/Assets/Resources/UI/Generated/icon_heroes.png"); }
.icon-diplomacy { background-image:url("project://database/Assets/Resources/UI/Generated/icon_diplomacy.png"); }
.icon-scheme { background-image:url("project://database/Assets/Resources/UI/Generated/icon_scheme.png"); }
.icon-research { background-image:url("project://database/Assets/Resources/UI/Generated/icon_research.png"); }
.icon-council { background-image:url("project://database/Assets/Resources/UI/Generated/icon_council.png"); }
.icon-report { background-image:url("project://database/Assets/Resources/UI/Generated/icon_report.png"); }
.icon-turn { background-image:url("project://database/Assets/Resources/UI/Generated/icon_turn.png"); }
.generated-command-icon { -unity-background-scale-mode:scale-to-fit; }

/* 시안 레이아웃: 좌측 성 현황, 중앙 전략 지도, 우측 목표·전투 알림을 한 화면에 배치합니다. */
.map-side-panel { position:absolute; top:16px; bottom:18px; width:248px; padding:22px 18px 18px; color:#e9eef1; overflow:hidden; }
.concept-side-panel { background-color:rgba(6,11,16,.95); border-width:1px; border-top-width:2px; border-color:#566672; border-top-color:#9aa8b3; }
.castle-summary-panel { left:16px; }
.campaign-summary-panel { right:16px; width:268px; }
.map-heading { left:280px; right:300px; width:auto; }
.map { left:280px; right:300px; top:86px; bottom:30px; }
.faction-legend { left:292px; top:98px; width:195px; }
.side-panel-kicker { margin-top:5px; color:#b4c0c8; font-size:12px; letter-spacing:2px; }
.side-panel-title { margin-top:9px; color:#ffffff; font-size:22px; -unity-font-style:bold; }
.side-panel-subtitle { margin-top:8px; color:#b7c2c9; font-size:12px; }
.global-castle-image { height:132px; margin-top:14px; background-color:#17232c; border-width:1px; border-color:#697985; -unity-background-scale-mode:scale-and-crop; }
.side-panel-stats { margin-top:14px; padding:12px; background-color:rgba(5,10,15,.78); color:#e6ecef; border-left-width:2px; border-left-color:#8697a3; white-space:normal; line-height:23px; }
.side-panel-copy { margin-top:10px; color:#b3bec5; white-space:normal; line-height:19px; }
.side-action { height:48px; margin-top:14px; color:#ffffff; border-width:0; font-size:15px; }
.side-panel-section { margin-top:18px; padding-bottom:7px; color:#ffffff; font-size:14px; -unity-font-style:bold; border-bottom-width:1px; border-bottom-color:#53636f; }
.campaign-summary-panel .objective-strip { position:relative; left:auto; right:auto; top:auto; width:auto; min-width:0; height:72px; margin-top:10px; padding:10px 12px; white-space:normal; -unity-text-align:middle-left; }
.alert-heading { margin-top:24px; }
.battle-alert-button { min-height:62px; margin-top:10px; padding:10px; color:#ffffff; border-width:0; white-space:normal; }
.side-panel-news { flex-grow:1; margin-top:10px; padding:10px; background-color:rgba(5,10,15,.72); color:#aeb9c0; white-space:normal; line-height:19px; }
.modal-panel.generated-panel-background { background-color:#0c141b; }
.modal-panel .modal-header { background-image:url("project://database/Assets/Resources/UI/Generated/popup_header.png"); -unity-background-scale-mode:stretch-to-fill; background-color:rgba(255,255,255,0); padding-left:24px; padding-right:18px; }
.modal-panel .modal-header .modal-title { color:#10161b; }
.modal-panel Button { background-image:url("project://database/Assets/Resources/UI/Generated/button_normal.png"); -unity-background-scale-mode:stretch-to-fill; background-color:rgba(0,0,0,0); border-width:0; }
.modal-panel Button.danger,.modal-panel Button.retreat { background-image:url("project://database/Assets/Resources/UI/Generated/button_danger.png"); }
.modal-close { background-image:url("project://database/Assets/Resources/UI/Generated/button_normal.png"); }
.global-command { position:relative; padding-left:38px; padding-right:7px; -unity-text-align:middle-right; }
.global-command .generated-command-icon { position:absolute; left:7px; top:11px; width:28px; height:28px; margin:0; }
.turn-button { position:relative; padding-left:48px; padding-right:14px; -unity-text-align:middle-center; }
.turn-button .generated-command-icon { position:absolute; left:12px; top:10px; width:36px; height:36px; margin:0; }

/* 생성 이미지의 모서리는 9-Slice로 고정하고 가운데 영역만 늘립니다. */
.generated-normal, .generated-primary, .generated-danger, .modal-panel Button, .modal-close {
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:28;
    -unity-slice-right:28;
    -unity-slice-top:24;
    -unity-slice-bottom:24;
}
.generated-panel-background {
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:56;
    -unity-slice-right:56;
    -unity-slice-top:48;
    -unity-slice-bottom:48;
}
.modal-panel .modal-header {
    -unity-slice-left:54;
    -unity-slice-right:54;
    -unity-slice-top:20;
    -unity-slice-bottom:20;
}

/* 시작과 이어하기 버튼은 동일한 클릭 영역과 시각 높이를 사용합니다. */
.campaign-start-button, .campaign-continue-button {
    height:50px;
    min-height:50px;
    flex-shrink:0;
    margin-top:10px;
}

/* 이미지 버튼은 기존 단색 반전을 사용하지 않고 원화를 유지한 채 틴트와 글자 대비로 상태를 표현합니다. */
.generated-normal, .generated-primary, .generated-danger, .modal-panel Button {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:#edf3f7;
    -unity-background-image-tint-color:#ffffff;
    -unity-text-outline-width:1px;
    -unity-text-outline-color:rgba(3,8,12,.9);
}
.generated-normal:hover, .generated-primary:hover, .modal-panel Button:hover {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:#ffffff;
    -unity-background-image-tint-color:#d9eaff;
}
.generated-danger:hover, .modal-panel Button.danger:hover, .modal-panel Button.retreat:hover {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:#ffffff;
    -unity-background-image-tint-color:#ffd1d1;
}
.generated-normal:active, .generated-primary:active, .generated-danger:active, .modal-panel Button:active {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:#ffffff;
    -unity-background-image-tint-color:#91a7b8;
}
.generated-normal:disabled, .generated-primary:disabled, .generated-danger:disabled, .modal-panel Button:disabled {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:#9aa3aa;
    opacity:.62;
    -unity-background-image-tint-color:#59656e;
}
.generated-normal:hover .generated-command-icon, .generated-primary:hover .generated-command-icon, .generated-danger:hover .generated-command-icon {
    -unity-background-image-tint-color:#ffffff;
}
.generated-normal:disabled .generated-command-icon, .generated-primary:disabled .generated-command-icon, .generated-danger:disabled .generated-command-icon {
    -unity-background-image-tint-color:#727d85;
}

/* 전략 지도 성은 색상 사각형 대신 세력별 성채·깃발 마커와 고정 명패를 사용합니다. */
.castle-node { width:68px; height:82px; min-height:0; margin-left:-34px; margin-top:-58px; padding:0; background-color:rgba(0,0,0,0); border-width:0; overflow:visible; }
.castle-node:hover { background-color:rgba(0,0,0,0); }
.castle-node-marker { position:absolute; left:13px; top:0; width:42px; height:58px; -unity-background-scale-mode:scale-to-fit; }
.castle-node-name { position:absolute; left:0; right:0; bottom:1px; height:22px; padding:3px 4px; background-color:rgba(5,9,13,.94); color:#f2f4f5; border-width:1px; border-color:#7f8b94; font-size:9px; -unity-font-style:bold; -unity-text-align:middle-center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.castle-node:hover .castle-node-marker { -unity-background-image-tint-color:#d9eaff; }
.castle-node:hover .castle-node-name { background-color:#dce5eb; color:#10161b; border-color:#ffffff; }
.castle-node-avalon .castle-node-marker { background-image:url("project://database/Assets/Resources/UI/Generated/map_castle_avalon.png"); }
.castle-node-valdor .castle-node-marker { background-image:url("project://database/Assets/Resources/UI/Generated/map_castle_valdor.png"); }
.castle-node-ironheart .castle-node-marker { background-image:url("project://database/Assets/Resources/UI/Generated/map_castle_ironheart.png"); }
.castle-node-sylvanroad .castle-node-marker { background-image:url("project://database/Assets/Resources/UI/Generated/map_castle_sylvanroad.png"); }
.castle-node-necropolis .castle-node-marker { background-image:url("project://database/Assets/Resources/UI/Generated/map_castle_necropolis.png"); }

/* 전역 좌측 패널은 성 이미지·수치·영웅 카드를 상업 전략 게임 수준의 정보 계층으로 묶습니다. */
.global-castle-hero-cards { height:80px; margin-top:9px; flex-direction:row; justify-content:space-between; }
.global-hero-card { width:24%; height:78px; background-color:#0b1218; border-width:1px; border-color:#5d6b75; }
.global-hero-portrait { height:56px; background-color:#111b23; -unity-background-scale-mode:scale-and-crop; }
.global-hero-name { height:20px; padding:2px; background-color:rgba(4,8,12,.95); color:#edf2f5; font-size:9px; -unity-text-align:middle-center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.objective-progress-track { height:7px; margin-top:8px; background-color:#18242d; border-width:1px; border-color:#53636f; }
.objective-progress-fill { height:100%; width:0; background-color:#6e99b8; }

/* 성 내정 화면 시안: 좌측 현황, 중앙 성 전경, 우측 명령, 하단 영웅·시설·중점의 네 구역입니다. */
.castle-overview-panel { position:absolute; left:18px; top:112px; bottom:18px; width:304px; padding:18px 16px; overflow:hidden; }
.castle-panel-heading { height:34px; color:#ffffff; font-size:19px; -unity-font-style:bold; border-bottom-width:1px; border-bottom-color:#667681; }
.castle-overview-panel .governor-full { position:relative; left:auto; bottom:auto; width:100%; height:225px; margin-top:12px; background-color:#101923; border-width:1px; border-color:#71808b; }
.castle-overview-panel .castle-stat-panel { position:relative; left:auto; top:auto; width:100%; margin-top:12px; padding:0; flex-direction:column; flex-wrap:nowrap; }
.castle-overview-panel .castle-stat { width:100%; height:48px; margin:0 0 6px 0; padding-left:72px; -unity-text-align:middle-left; font-size:12px; }
.castle-top-strip { left:340px; right:258px; height:76px; background-color:rgba(6,11,16,.93); }
.castle-command-menu { right:18px; top:112px; bottom:18px; width:222px; padding:17px 13px; background-color:rgba(6,11,16,.96); }
.castle-command { flex-grow:1; min-height:42px; max-height:52px; margin-bottom:7px; }
.castle-bottom-info { left:340px; right:258px; bottom:18px; height:252px; padding:16px 18px; background-color:rgba(6,11,16,.94); }
.castle-bottom-info .project-status { min-height:46px; padding:12px 14px; }
.castle-bottom-info .slot-columns { margin-top:12px; }

@media (max-width:1365px) {
    .castle-node { width:58px; height:70px; margin-left:-29px; margin-top:-50px; }
    .castle-node-marker { left:11px; width:36px; height:49px; }
    .castle-node-name { height:19px; font-size:8px; }
    .castle-overview-panel { width:252px; padding-left:12px; padding-right:12px; }
    .castle-overview-panel .governor-full { height:180px; }
    .castle-overview-panel .castle-stat { height:42px; padding-left:60px; }
    .castle-top-strip { left:284px; right:220px; }
    .castle-command-menu { width:202px; }
    .castle-bottom-info { left:284px; right:220px; height:224px; }
}

@media (max-width:1365px) {
    .map-side-panel { width:218px; padding-left:14px; padding-right:14px; }
    .campaign-summary-panel { width:232px; }
    .map-heading { left:246px; right:260px; }
    .map { left:246px; right:260px; }
    .faction-legend { left:254px; width:175px; }
    .global-castle-image { height:105px; }
    .global-command { width:86px; }
    .global-command { padding-left:31px; padding-right:5px; font-size:12px; }
    .global-command .generated-command-icon { left:5px; top:13px; width:24px; height:24px; }
    .turn-button { padding-left:39px; padding-right:7px; font-size:15px; }
    .turn-button .generated-command-icon { left:7px; top:13px; width:30px; height:30px; }
}

/* 시안형 서체 체계: 화면 전체를 명조로 통일하고 숫자 중심의 작은 정보만 고딕을 사용합니다. */
.app {
    -unity-font-definition:url("project://database/Assets/Fonts/NotoSerifKR-VariableFont_wght.ttf");
}
.app Label, .app Button, .app TextField, .app Toggle {
    -unity-font-definition:url("project://database/Assets/Fonts/NotoSerifKR-VariableFont_wght.ttf");
}
.resource-chip, .side-panel-stats, .castle-stat, .global-hero-name,
.castle-node-name, .zoom-label, .slot-caption {
    -unity-font-definition:url("project://database/Assets/Fonts/NotoSansKR-VariableFont_wght.ttf");
}

/* 시안형 상단 HUD는 큰 문장과 독립 자원 아이콘을 한 줄에 정렬합니다. */
.compact-hud {
    height:74px;
    padding:8px 24px;
    background-color:rgba(5,11,17,.99);
    border-bottom-width:1px;
    border-bottom-color:#52606a;
}
.faction-emblem { width:48px; height:56px; margin-right:12px; }
.faction-label {
    min-width:190px;
    padding-left:0;
    border-left-width:0;
    color:#f1eee7;
    font-size:25px;
}
.hud-separator { width:1px; height:38px; margin:0 14px; background-color:#26333d; }
.hud-resource-icon { width:30px; height:30px; flex-shrink:0; margin-right:8px; -unity-background-scale-mode:scale-to-fit; }
.hud-date-icon { background-image:url("project://database/Assets/Resources/UI/Generated/hud_flat_date.png"); }
.hud-gold-icon { background-image:url("project://database/Assets/Resources/UI/Generated/hud_flat_gold.png"); }
.hud-mana-icon { background-image:url("project://database/Assets/Resources/UI/Generated/hud_flat_mana.png"); }
.hud-influence-icon { background-image:url("project://database/Assets/Resources/UI/Generated/hud_flat_influence.png"); }
.date-label {
    min-width:120px;
    color:#ece9e3;
    font-size:19px;
    -unity-font-style:normal;
}
.resource-chip {
    min-width:126px;
    height:42px;
    margin-left:0;
    padding:8px 4px;
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:#ece9e3;
    font-size:16px;
    -unity-text-align:middle-left;
}

/* 장식형 액자를 절제된 흑청색 9-Slice 버튼으로 교체합니다. */
.generated-normal { background-image:url("project://database/Assets/Resources/UI/Generated/button_flat_normal.png"); }
.generated-primary { background-image:url("project://database/Assets/Resources/UI/Generated/button_flat_primary.png"); }
.generated-danger { background-image:url("project://database/Assets/Resources/UI/Generated/button_flat_danger.png"); }
.generated-ornate-action {
    background-image:url("project://database/Assets/Resources/UI/Generated/button_type_h.png");
    -unity-slice-left:112;
    -unity-slice-right:32;
    -unity-slice-top:32;
    -unity-slice-bottom:32;
}
.modal-panel Button, .modal-close { background-image:url("project://database/Assets/Resources/UI/Generated/button_flat_normal.png"); }
.modal-panel Button.danger, .modal-panel Button.retreat { background-image:url("project://database/Assets/Resources/UI/Generated/button_flat_danger.png"); }
.generated-normal, .generated-primary, .generated-danger, .modal-panel Button, .modal-close {
    -unity-slice-left:18;
    -unity-slice-right:18;
    -unity-slice-top:16;
    -unity-slice-bottom:16;
}

/* 시안형 하단 명령 바와 신규 단색 명령 아이콘입니다. */
.global-command-bar {
    height:78px;
    padding:9px 12px;
    background-color:#070d13;
    border-width:1px;
    border-color:#4b5964;
}
.global-command {
    width:112px;
    height:58px;
    margin-right:2px;
    padding-left:44px;
    padding-right:10px;
    background-image:url("project://database/Assets/Resources/UI/Generated/right_action_button.png");
    -unity-slice-left:28;
    -unity-slice-right:28;
    -unity-slice-top:20;
    -unity-slice-bottom:20;
    color:#e8e3d9;
    font-size:17px;
    -unity-text-align:middle-center;
    -unity-text-outline-width:0;
}
.global-command .generated-command-icon {
    left:10px;
    top:13px;
    width:32px;
    height:32px;
}
.turn-button {
    height:60px;
    padding-left:55px;
    color:#f1eee8;
    font-size:21px;
    -unity-text-outline-width:0;
}
.turn-button .generated-command-icon { left:14px; top:11px; width:38px; height:38px; }
.icon-military { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_military.png"); }
.icon-heroes { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_heroes.png"); }
.icon-diplomacy { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_diplomacy.png"); }
.icon-scheme { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_scheme.png"); }
.icon-research { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_research.png"); }
.icon-faction { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_faction.png"); }
.icon-council { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_council.png"); }
.icon-report { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_report.png"); }
.icon-turn { background-image:url("project://database/Assets/Resources/UI/Generated/icon_flat_turn.png"); }

@media (max-width:1365px) {
    .compact-hud { height:62px; padding-left:10px; padding-right:10px; }
    .faction-emblem { width:38px; height:46px; margin-right:7px; }
    .faction-label { min-width:128px; font-size:19px; }
    .hud-separator { margin-left:6px; margin-right:6px; height:30px; }
    .hud-resource-icon { width:23px; height:23px; margin-right:3px; }
    .date-label { min-width:92px; font-size:15px; }
    .resource-chip { min-width:90px; font-size:12px; }
    .global-command { width:86px; height:54px; padding-left:33px; padding-right:4px; font-size:13px; }
    .global-command .generated-command-icon { left:6px; top:14px; width:26px; height:26px; }
    .turn-button { width:158px; padding-left:42px; font-size:17px; }
    .turn-button .generated-command-icon { left:8px; top:14px; width:30px; height:30px; }
}

/* 작은 버튼 문자는 획이 뭉개지지 않도록 고딕체와 무외곽선으로 통일합니다. */
.app Button, .generated-normal, .generated-primary, .generated-danger,
.modal-panel Button, .modal-close, .castle-command, .objective-strip,
.battle-alert-button, .campaign-start-button, .campaign-continue-button,
.difficulty-card, .variant-card {
    -unity-font-definition:url("project://database/Assets/Fonts/NotoSansKR-VariableFont_wght.ttf");
    -unity-font-style:normal;
    -unity-text-outline-width:0;
    -unity-text-outline-color:rgba(0,0,0,0);
}

/* 전략 지도와 성 화면 우측 패널은 동일한 흑청색·은색 시각 체계를 사용합니다. */
.campaign-summary-panel, .castle-command-menu {
    background-image:url("project://database/Assets/Resources/UI/Generated/right_panel_frame.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:22;
    -unity-slice-right:22;
    -unity-slice-top:22;
    -unity-slice-bottom:22;
    background-color:rgba(0,0,0,0);
    border-width:0;
}
.right-panel-heading {
    height:48px;
    min-height:48px;
    margin:0 0 8px 0;
    padding:8px 38px;
    background-image:url("project://database/Assets/Resources/UI/Generated/right_panel_header.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:38;
    -unity-slice-right:38;
    -unity-slice-top:20;
    -unity-slice-bottom:20;
    color:#f2f0eb;
    font-size:18px;
    -unity-font-style:normal;
    -unity-text-align:middle-center;
    border-width:0;
}
.right-panel-section-heading {
    height:36px;
    margin:8px 0 2px 0;
    padding:4px 24px;
    background-image:url("project://database/Assets/Resources/UI/Generated/right_panel_header.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:38;
    -unity-slice-right:38;
    -unity-slice-top:20;
    -unity-slice-bottom:20;
    color:#dedbd4;
    font-size:14px;
    -unity-font-style:normal;
    -unity-text-align:middle-center;
    border-width:0;
}
.campaign-summary-panel .objective-strip {
    min-height:88px;
    padding:14px 16px;
    background-image:url("project://database/Assets/Resources/UI/Generated/right_objective_card.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:22;
    -unity-slice-right:22;
    -unity-slice-top:22;
    -unity-slice-bottom:22;
    color:#f0eee8;
    border-width:0;
}
.campaign-summary-panel .side-panel-news {
    min-height:68px;
    padding:12px 16px;
    background-image:url("project://database/Assets/Resources/UI/Generated/right_notice_row.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:22;
    -unity-slice-right:22;
    -unity-slice-top:22;
    -unity-slice-bottom:22;
    color:#d8dde0;
    border-width:0;
}
.campaign-summary-panel .battle-alert-button {
    min-height:68px;
    padding:12px 16px;
    background-image:url("project://database/Assets/Resources/UI/Generated/right_danger_row.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:22;
    -unity-slice-right:22;
    -unity-slice-top:22;
    -unity-slice-bottom:22;
    color:#ffbbb5;
    border-width:0;
}
.castle-command-menu { padding:14px 13px; }
.castle-command-menu .command-title { margin-bottom:9px; padding-bottom:8px; }
.castle-command-menu .castle-command {
    min-height:46px;
    max-height:54px;
    margin-bottom:5px;
    padding:8px 14px;
    background-image:url("project://database/Assets/Resources/UI/Generated/right_notice_row.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:22;
    -unity-slice-right:22;
    -unity-slice-top:22;
    -unity-slice-bottom:22;
    color:#e7e5df;
    border-width:0;
    font-size:14px;
    -unity-text-align:middle-left;
}
.castle-command-menu .castle-command.danger {
    background-image:url("project://database/Assets/Resources/UI/Generated/right_danger_row.png");
    color:#ffbbb5;
}
#castle-record-button {
    background-image:url("project://database/Assets/Resources/UI/Generated/right_action_button.png");
    -unity-slice-left:28;
    -unity-slice-right:28;
    -unity-slice-top:20;
    -unity-slice-bottom:20;
    -unity-text-align:middle-center;
}
