                <ui:VisualElement class="slot-columns">
                    <ui:VisualElement class="slot-column castle-slot-section hero-slot-section">
                        <ui:Label text="주둔 영웅" class="section-label slot-section-title"/>
                        <ui:ScrollView mode="Vertical" class="slot-scroll hero-slot-scroll">
