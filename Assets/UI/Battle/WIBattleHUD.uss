.battle-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 18px;
}

.battle-status {
    align-self: center;
    background-color: rgba(10, 14, 20, 0.88);
    color: rgb(232, 213, 164);
    border-width: 2px;
    border-color: rgb(142, 105, 48);
    padding: 10px 22px;
    font-size: 20px;
}

.command-feedback {
    align-self: center;
    margin-top: 8px;
    background-color: rgba(10, 14, 20, 0.82);
    color: rgb(218, 207, 177);
    padding: 7px 16px;
    font-size: 16px;
}

.selection-info {
    position: absolute;
    left: 18px;
    top: 18px;
    max-width: 360px;
    background-color: rgba(10, 14, 20, 0.84);
    color: rgb(210, 224, 226);
    padding: 9px 13px;
    font-size: 15px;
}

.bottom-bar {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    flex-direction: row;
    justify-content: space-between;
}

.command-group, .skill-group {
    flex-direction: row;
}

.command-button, .skill-button {
    min-width: 112px;
    min-height: 58px;
    margin-right: 8px;
    background-color: rgb(36, 43, 55);
    color: rgb(238, 224, 188);
    border-width: 2px;
    border-color: rgb(144, 107, 51);
    font-size: 18px;
}

.retreat {
    background-color: rgb(86, 28, 27);
}

.active-command {
    background-color: rgb(125, 88, 25);
    border-color: rgb(244, 205, 95);
    color: rgb(255, 245, 205);
}

.retreat-armed {
    background-color: rgb(170, 42, 34);
    border-color: rgb(255, 135, 105);
}

/* 전투 HUD도 행정 화면과 같은 흑백 정보 계층을 사용합니다. */
.battle-status,.command-feedback,.selection-info {
    background-color: rgba(4, 6, 8, 0.9);
    color: rgb(240, 242, 244);
    border-color: rgb(117, 124, 130);
}

.command-button,.skill-button {
    background-color: rgb(27, 30, 33);
    color: rgb(244, 245, 246);
    border-color: rgb(112, 119, 125);
}

.active-command {
    background-color: rgb(238, 240, 242);
    color: rgb(15, 17, 19);
    border-color: rgb(255, 255, 255);
}

.command-button:hover,.skill-button:hover {
    background-color: rgb(241, 242, 243);
    color: rgb(17, 19, 21);
    border-color: rgb(255, 255, 255);
}

.command-button:active,.skill-button:active {
    background-color: rgb(191, 196, 200);
    color: rgb(8, 10, 12);
}

.command-button:disabled,.skill-button:disabled {
    background-color: rgb(32, 35, 38);
    color: rgb(119, 125, 130);
    border-color: rgb(70, 76, 81);
    opacity: 0.48;
}

.retreat:hover,.retreat-armed {
    background-color: rgb(138, 48, 45);
    color: rgb(255, 255, 255);
    border-color: rgb(224, 154, 149);
}

/* 전략 화면 V2와 동일한 청회색 지휘 패널 스타일을 전투 HUD에도 적용합니다. */
.battle-status {
    min-width: 420px;
    background-color: rgba(7, 13, 19, 0.94);
    color: rgb(242, 246, 248);
    border-width: 1px;
    border-top-width: 2px;
    border-color: rgb(85, 101, 113);
}
.command-feedback,.selection-info {
    background-color: rgba(8, 15, 21, 0.92);
    color: rgb(202, 212, 219);
    border-width: 1px;
    border-color: rgb(70, 85, 96);
}
.bottom-bar {
    padding: 10px;
    background-color: rgba(6, 11, 16, 0.92);
    border-width: 1px;
    border-color: rgb(76, 91, 102);
}
.command-button,.skill-button {
    min-height: 62px;
    background-color: rgb(17, 28, 37);
    color: rgb(237, 243, 246);
    border-width: 1px;
    border-color: rgb(83, 100, 112);
}
.active-command {
    background-color: rgb(34, 75, 109);
    color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(126, 159, 183);
}
.retreat { background-color: rgb(103, 40, 38); border-color: rgb(159, 80, 75); }
.generated-texture-button { -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgb(255, 255, 255); }
.generated-texture-button:hover { -unity-background-image-tint-color: rgb(217, 228, 236); }
.generated-texture-button:active { -unity-background-image-tint-color: rgb(174, 187, 197); }
.generated-texture-button:disabled { -unity-background-image-tint-color: rgb(102, 114, 123); }
.generated-normal { background-image:url("project://database/Assets/Resources/UI/Generated/button_normal.png"); -unity-background-scale-mode:stretch-to-fill; }
.generated-primary { background-image:url("project://database/Assets/Resources/UI/Generated/button_primary.png"); -unity-background-scale-mode:stretch-to-fill; }
.generated-danger { background-image:url("project://database/Assets/Resources/UI/Generated/button_danger.png"); -unity-background-scale-mode:stretch-to-fill; }
.skill-button { background-image:url("project://database/Assets/Resources/UI/Generated/button_primary.png"); -unity-background-scale-mode:stretch-to-fill; }

/* 버튼의 양끝과 모서리는 고정하고 가운데 부분만 크기에 맞춰 확장합니다. */
.generated-normal, .generated-primary, .generated-danger, .skill-button {
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:28;
    -unity-slice-right:28;
    -unity-slice-top:24;
    -unity-slice-bottom:24;
}

/* 전투 이미지 버튼도 단색 배경 반전 대신 텍스처 틴트로 조작 상태를 표시합니다. */
.generated-normal, .generated-primary, .generated-danger, .skill-button {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:rgb(237,243,246);
    -unity-background-image-tint-color:rgb(255,255,255);
    -unity-text-outline-width:1px;
    -unity-text-outline-color:rgba(3,8,12,.9);
}
.generated-normal:hover, .generated-primary:hover, .skill-button:hover {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:rgb(255,255,255);
    -unity-background-image-tint-color:rgb(217,234,255);
}
.generated-danger:hover {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:rgb(255,255,255);
    -unity-background-image-tint-color:rgb(255,209,209);
}
.generated-normal:active, .generated-primary:active, .generated-danger:active, .skill-button:active {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:rgb(255,255,255);
    -unity-background-image-tint-color:rgb(145,167,184);
}
.generated-normal:disabled, .generated-primary:disabled, .generated-danger:disabled, .skill-button:disabled {
    background-color:rgba(0,0,0,0);
    border-width:0;
    color:rgb(154,163,170);
    opacity:.62;
    -unity-background-image-tint-color:rgb(89,101,110);
}

/* 전투 명령 버튼도 작은 한글이 뭉개지지 않도록 고딕체와 무외곽선을 사용합니다. */
.command-button, .generated-normal, .generated-primary, .generated-danger, .skill-button, .retreat {
    -unity-font-definition:url("project://database/Assets/Fonts/NotoSansKR-VariableFont_wght.ttf");
    -unity-font-style:normal;
    -unity-text-outline-width:0;
    -unity-text-outline-color:rgba(0,0,0,0);
}

/* 단색으로 채우던 전투 HUD 패널을 Background A Type 9-Slice 이미지로 통일합니다. */
.battle-status,
.command-feedback,
.selection-info,
.bottom-bar {
    background-image:url("project://database/Assets/Resources/UI/Generated/bg_type_a.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:3;
    -unity-slice-right:3;
    -unity-slice-top:3;
    -unity-slice-bottom:3;
    background-color:rgba(0,0,0,0);
    border-width:0;
}

/* 전투 시안에서 분리한 네 프레임을 HUD의 실제 배경 계층으로 배치합니다. */
.battle-top-status-frame {
    position:absolute;
    left:8%;
    right:8%;
    top:12px;
    height:108px;
    align-items:center;
    justify-content:center;
    background-image:url("project://database/Assets/Art/UI/Battle/Battle_Top_Status_Frame_V1.png");
    -unity-background-scale-mode:stretch-to-fill;
}

.battle-top-status-frame .battle-status {
    min-width:0;
    margin-top:7px;
    padding:0;
    background-image:none;
    background-color:rgba(0,0,0,0);
    color:rgb(238,224,188);
    font-size:18px;
}

.bottom-bar {
    left:12px;
    right:12px;
    bottom:8px;
    height:178px;
    padding:0;
    align-items:flex-end;
    background-image:none;
    background-color:rgba(0,0,0,0);
}

.battle-character-info-frame {
    width:365px;
    height:178px;
    flex-direction:row;
    align-items:center;
    background-image:url("project://database/Assets/Art/UI/Battle/Battle_Character_Info_Frame_V1.png");
    -unity-background-scale-mode:stretch-to-fill;
}

.battle-portrait-slot {
    width:39%;
    height:72%;
    margin-left:7%;
}

.battle-character-info-frame .selection-info {
    position:relative;
    left:auto;
    top:auto;
    width:47%;
    max-width:none;
    margin-left:2%;
    padding:7px;
    background-image:none;
    background-color:rgba(0,0,0,0);
    border-width:0;
    white-space:normal;
    font-size:13px;
}

.battle-command-frame {
    width:524px;
    height:127px;
    margin-left:auto;
    margin-right:auto;
    padding:20px 26px 15px 26px;
    justify-content:flex-end;
    background-image:url("project://database/Assets/Art/UI/Battle/Battle_Command_Bar_Frame_V1.png");
    -unity-background-scale-mode:stretch-to-fill;
}

.battle-command-frame .command-feedback {
    margin:0 0 5px 0;
    padding:0;
    align-self:center;
    background-image:none;
    background-color:rgba(0,0,0,0);
    border-width:0;
    font-size:12px;
}

.command-group {
    width:100%;
    justify-content:space-between;
}

.battle-command-frame .command-button {
    min-width:0;
    width:23%;
    min-height:48px;
    height:48px;
    margin:0;
    background-image:none;
    background-color:rgba(0,0,0,0);
    border-width:0;
    font-size:15px;
}

.battle-skill-frame {
    width:376px;
    height:107px;
    padding:29px 20px 17px 20px;
    background-image:url("project://database/Assets/Art/UI/Battle/Battle_Skill_Bar_Frame_V1.png");
    -unity-background-scale-mode:stretch-to-fill;
}

.battle-skill-frame .skill-group {
    width:100%;
    height:100%;
    justify-content:space-between;
}

.battle-skill-frame .skill-button {
    min-width:0;
    width:23%;
    min-height:0;
    height:100%;
    margin:0;
    background-image:none;
    background-color:rgba(0,0,0,0);
    border-width:0;
    font-size:13px;
}

/* 실제 슬롯 경계 안에 명령과 스킬을 고정하고 페이지 조작 공간을 확보합니다. */
.battle-command-frame { padding: 16px 38px 16px 38px; }
.battle-command-frame .command-feedback { position:absolute; left:10px; right:10px; bottom:130px; height:42px; white-space:normal; font-size:15px; -unity-text-align:middle-center; background-color:rgba(7,13,19,.92); }
.battle-command-frame .command-group { height:100%; }
.battle-command-frame .command-button { height:100%; min-height:0; width:25%; flex-shrink:1; -unity-text-align:middle-center; padding:0; }
.battle-skill-frame { height:148px; padding:12px 14px 42px 14px; background-image:url("project://database/Assets/Resources/UI/Generated/bg_type_a.png"); }
.battle-skill-frame .skill-button { width:25%; flex-shrink:1; white-space:normal; -unity-text-align:middle-center; background-color:rgb(17,28,37); border-width:1px; border-color:rgb(83,100,112); }
.skill-pager { position:absolute; left:14px; right:14px; bottom:5px; height:32px; flex-direction:row; justify-content:space-between; align-items:center; }
.skill-pager Button { width:64px; height:32px; margin:0; background-color:rgb(25,38,49); color:rgb(237,243,246); }
.skill-pager Label { color:rgb(237,243,246); font-size:15px; }
.battle-top-status-frame .battle-status { width:90%; -unity-text-align:middle-left; color:rgb(238,242,245); }
.battle-character-info-frame .selection-info { align-self:flex-start; margin-top:36px; height:74px; font-size:14px; }